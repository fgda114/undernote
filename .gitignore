# ─── 로컬 전용 (2026-09-06 코드 전용 저장소로 정리) ─────────
# BATHOS 파이프라인 산출물(.agent-team/)과 에이전트 설정(.claude/)은
# 로컬에만 둔다. 디스크에는 남지만 커밋되지 않으며, 히스토리에서도 제거되었다.
.agent-team/
.claude/

# 감사 로그 해시 체인 (키는 절대 커밋 금지)
**/*.audit.jsonl

# 락 · 백업 · 격리본
*.lock
public/covers/tmp-og-test-cover.jpg   # og.test.ts 임시 커버 (afterAll에서 삭제)
**/*.bak.*
**/*.quarantine.*

# ─── 의존성 · 빌드 산출물 ──────────────────────────────────
node_modules/
dist/
build/
out/
.next/
.svelte-kit/
.nuxt/
.cache/
*.tsbuildinfo

# ─── 환경변수 · 시크릿 ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── 로그 ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── 에디터 · OS ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ─── 테스트 · 커버리지 ─────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ─── undernote 빌드 산출물 (W5.0) ─────────────────────────
# reports/ = build-report 산출물 — 콘텐츠가 아니므로 커밋 금지 (data-model-erd §4)
reports/
# Astro 로컬 캐시·생성 타입
.astro/

# 폰트 릴리스 조회 등 API 응답 잔여물
pret-rel.json
*-rel.json

# 리뷰·QA가 경합 회피로 만드는 분리 빌드 산출물
dist-check-*/
dist-*/
