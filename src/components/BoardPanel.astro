---
/**
 * BoardPanel (components.md §10) — one bucket column: label + BoardRow×0~5.
 * The panel gained a surface in the reskin: on a dark page a bare column has
 * no edge, and depth here is made of surface steps plus a 1px keyline, not
 * shadows.
 * Empty bucket shows the exact copy (never hidden — the annual structure
 * being visible IS the point of the board, D5); 1~4 rows show as-is with no
 * placeholder padding (R-4).
 * The <ol> is semantic ranking: markup order = rank order.
 */
import type { Board } from '../lib/derive/lists.ts';
import BoardRow from './BoardRow.astro';

interface Props {
  bucket: Board['buckets'][number];
}

const { bucket } = Astro.props;
---

<section class="panel">
  <h3 class="bucket-label">{bucket.label}</h3>
  {
    bucket.entries.length > 0 ? (
      <ol class="rows">
        {bucket.entries.map((entry, i) => (
          <BoardRow entry={entry} rank={i + 1} />
        ))}
      </ol>
    ) : (
      <p class="empty">아직 이 장르의 후보가 없습니다.</p>
    )
  }
</section>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-0);
    padding: var(--s-12);
  }
  .bucket-label {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    /* Bucket labels are Korean ("힙합/R&B", "록") — wide tracking would hurt
       them, so this one uses the Korean value even though it is uppercased. */
    letter-spacing: var(--label-ls-ko);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
    padding-bottom: var(--s-8);
    border-bottom: 1px solid var(--line);
  }
  .rows {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
  }
  .empty {
    font-size: var(--fs-14);
    line-height: 20px;
    color: var(--muted);
    padding: var(--s-12) 0;
  }
</style>
