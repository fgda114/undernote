---
/**
 * SpecMeta (components.md §7) — the review rail's spec block. New in the
 * 2026-09 reskin.
 *
 * Every row below maps to a field that already exists in the content model.
 * The reference mockup also showed a tracklist, BPM, runtime and a staff
 * credit; none of those exist here, so none of them are here. An optional
 * field with no value removes its ROW — it never renders a dash or a blank,
 * because a spec sheet full of placeholders reads as a broken page (R-4).
 *
 * `mbid` is deliberately not surfaced: it is an internal identifier and
 * means nothing to a reader.
 */
import { withBase } from '../lib/paths.ts';

interface Props {
  artistLinks: { slug: string; name: string }[];
  releaseDateText: string;
  bucketId: string;
  bucketLabel: string;
  reviewDate: string;
  label?: string;
  tags: { slug: string; label: string }[];
}

const { artistLinks, releaseDateText, bucketId, bucketLabel, reviewDate, label, tags } = Astro.props;
---

<dl class="spec" aria-label="앨범 정보">
  <div class="row">
    <dt>Artist</dt>
    <dd>
      {
        artistLinks.map((artist, i) => (
          <>
            {i > 0 && ', '}
            <a class="artist-link" href={withBase(`/artists/${artist.slug}/`)}>
              {artist.name}
            </a>
          </>
        ))
      }
    </dd>
  </div>
  <div class="row">
    <dt>Release</dt>
    <dd class="tnum">{releaseDateText}</dd>
  </div>
  {
    label && (
      <div class="row">
        <dt>Label</dt>
        <dd>{label}</dd>
      </div>
    )
  }
  <div class="row">
    <dt>Genre</dt>
    <dd><a class="meta-link" href={withBase(`/archive/genre/${bucketId}/`)}>{bucketLabel}</a></dd>
  </div>
  {
    tags.length > 0 && (
      <div class="row">
        <dt>Tags</dt>
        <dd class="tags">
          {tags.map((tag) => (
            <a class="chip" href={withBase(`/archive/tag/${tag.slug}/`)}>
              {tag.label}
            </a>
          ))}
        </dd>
      </div>
    )
  }
  <div class="row">
    <dt>Reviewed</dt>
    <dd><time class="tnum" datetime={reviewDate}>{reviewDate}</time></dd>
  </div>
</dl>

<style>
  .spec {
    margin: 0;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-0);
    padding: var(--s-12);
  }
  .row {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: var(--s-12);
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: 0;
  }
  dt {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: var(--label-ls);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--fs-14);
    line-height: 20px;
    font-weight: 500;
    color: var(--ink);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* Links inside a value are inline text, so the 44px target rule does not
     apply (WCAG 2.5.8 inline exception) — they get color + underline. */
  .artist-link,
  .meta-link {
    color: var(--accent-2-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: text-decoration-thickness var(--t-micro);
  }
  .artist-link:hover,
  .meta-link:hover {
    text-decoration-thickness: 2px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: var(--s-4) 6px;
    background: var(--surface-3);
    border-radius: var(--r-0);
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.04em;
    font-weight: 500;
    color: var(--muted);
    transition: color var(--t-micro);
  }
  .chip:hover {
    color: var(--accent-2-ink);
  }
</style>
