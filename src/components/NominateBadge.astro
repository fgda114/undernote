---
/**
 * NominateBadge (components.md §10) — "● 지금 올해의 앨범 노미네이트 {n}위",
 * linking to the year list (the review→board reverse path, D6-3).
 *
 * Lives at the FOOT OF THE REVIEW RAIL, under the spec block (moved there
 * 2026-09-07; it sat in the hero under the album line from D2-R until then).
 * It is derived from the score (SS-4), so it belongs with the rail's other
 * derived facts rather than with the headline — and on a narrow screen the
 * single column now reaches the score before the thing the score produced,
 * which the hero placement had backwards.
 * Not nominated → the caller simply doesn't render this (no empty shell).
 * Color-independence: the text says everything; the colour is reinforcement.
 *
 * Outline, not fill: a page may carry exactly one large accent surface, and
 * that one is the score plate. A second filled block would halve its weight,
 * so the badge stays a line until you hover it.
 *
 * "올해의 앨범" REPLACED THE PER-GENRE LABEL (2026-09-09, decision-maker
 * request): the year list page stopped rendering its 8 genre-board sections
 * the same day (list/[year]/index.astro's own intro), so a bucket name here
 * would have pointed a reader at a section that no longer exists on the page
 * this badge links to. `rank` now comes from the same overall top 10 the
 * page itself shows — this SAME COMMIT also changed
 * lib/derive/lists.ts#deriveBadgeMap to derive it from `Top10Progressive`
 * instead of a bucket board (that derive-layer change is outside this
 * package's owned paths; see lists.ts's own comment for the full reasoning)
 * — so the copy now reads as an overall rank because it is one.
 * `bucketLabel` was this component's only
 * other prop and had no remaining caller once this line stopped needing it,
 * so it was removed rather than left unused (see reviews/[slug].astro's
 * call site and 08-impl-notes/frontend.md for what that removal reported
 * upstream).
 */
interface Props {
  rank: number;
  year: number;
}

import { withBase } from '../lib/paths.ts';

const { rank, year } = Astro.props;
---

<a class="badge" href={withBase(`/list/${year}/`)}>
  <span aria-hidden="true">●</span>
  지금 올해의 앨범 노미네이트 {rank}위 → 보드 보기
</a>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    min-height: 44px;
    padding: 0 var(--s-12);
    border: 1px solid var(--accent);
    border-radius: var(--r-0);
    color: var(--accent-ink);
    font-family: var(--sans);
    font-size: var(--fs-14);
    line-height: 20px;
    font-weight: 600;
    transition: color var(--t-micro), background var(--t-micro);
  }
  .badge:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
