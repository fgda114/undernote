---
/**
 * NominateBadge (components.md §10) — "● 지금 {버킷} 노미네이트 {n}위",
 * linking to the year list (the review→board reverse path, D6-3).
 *
 * Lives in the review hero, under the album line (D2-R): the badge is
 * derived from the score (SS-4), and since the score itself now opens the
 * page there is nothing left to leak.
 * Not nominated → the caller simply doesn't render this (no empty shell).
 * Color-independence: the text says everything; the lime is reinforcement.
 *
 * Outline, not fill: a page may carry exactly one large lime surface, and
 * that one is the score plate. A second filled block would halve its weight,
 * so the badge stays a line until you hover it.
 */
interface Props {
  bucketLabel: string;
  rank: number;
  year: number;
}

import { withBase } from '../lib/paths.ts';

const { bucketLabel, rank, year } = Astro.props;
---

<a class="badge" href={withBase(`/list/${year}/`)}>
  <span aria-hidden="true">●</span>
  지금 {bucketLabel} 노미네이트 {rank}위 → 보드 보기
</a>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    min-height: 44px;
    padding: 0 var(--s-12);
    border: 1px solid var(--accent);
    border-radius: var(--r-0);
    color: var(--accent-ink);
    font-family: var(--sans);
    font-size: var(--fs-14);
    line-height: 20px;
    font-weight: 600;
    transition: color var(--t-micro), background var(--t-micro);
  }
  .badge:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  /* The one place a component needs a scheme query: on light, a lime border
     around a lime fill is 1.16:1 — the filled state would have no edge at
     all (tokens.md §3.4). Default state is unaffected. */
  @media (prefers-color-scheme: light) {
    .badge:hover {
      border-color: var(--ink);
    }
  }
</style>
