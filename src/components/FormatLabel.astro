---
/**
 * FormatLabel — the seal-colored overline (components.md §3). Not decoration:
 * real text, read first by screen readers on purpose (the format IS the
 * context). One of the five sanctioned --seal slots.
 */
interface Props {
  /** Label text: Reviews / Notes / Artists / page overlines (e.g. "2026 올해의 앨범"). */
  text: string;
}

const { text } = Astro.props;
---

<p class="format-label">{text}</p>

<style>
  .format-label {
    font-family: var(--sans);
    font-size: var(--fs-13);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.14em;
    /* Section names are English (D2-R sibling decision); uppercase is a
       no-op on the Korean page overlines that still pass through here. */
    text-transform: uppercase;
    color: var(--seal);
  }
</style>
