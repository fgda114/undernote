---
/**
 * ScoreMark (components.md §5) — the review hero's score plate.
 *
 * Placement: review hero only, directly under the cover with zero gap, so
 * "this album, this score" reads as one object (D2-R 2026-09-06 — the score
 * is the entry point, not the conclusion). The 96px ring it replaced was a
 * leftover from the light, paper-and-seal identity; a filled square holds
 * its weight when it shrinks to a phone width, a hairline ring does not.
 *
 * Renders the STORED STRING verbatim ("8.3" stays "8.3", never 8.30/8) —
 * lib/score.ts owns the format and this component never reformats it.
 *
 * Markup contract: the figure must be the ONLY text node of its element —
 * a dist-wide test locates scores as `>8.3<`. That is why `/10` is a
 * separate span and not a suffix on the same node.
 */
interface Props {
  score: string;
}

const { score } = Astro.props;
---

<p class="score-mark plate">
  <span class="value tnum" aria-hidden="true">{score}</span>
  <span class="scale" aria-hidden="true">/10</span>
  {/* AT reads the full scale — a bare "8.3" is meaningless out of context. */}
  <span class="sr-only">평점 {score} / 10점 만점</span>
</p>

<style>
  .score-mark {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
    height: 88px;
    padding: 0 var(--s-16);
    margin: 0;
  }
  .value {
    font-family: var(--display);
    font-size: var(--fs-44);
    line-height: 44px;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: var(--on-accent);
  }
  .scale {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--on-accent);
  }
  @media (max-width: 640px) {
    .score-mark {
      height: 72px;
    }
    .value {
      font-size: var(--fs-34);
      line-height: 34px;
    }
  }
</style>
