---
/**
 * ScoreMark (components.md §9a) — the hero score dial.
 *
 * Placement: review hero, left of the title (D2-R 2026-09-06 — the score is
 * the entry point, not the conclusion; supersedes the original D2 "말미 배치").
 * One of the five sanctioned --seal slots (verdict score).
 *
 * Renders the STORED STRING verbatim ("8.3" stays "8.3", never 8.30/8) —
 * lib/score.ts owns the format and this component never reformats it.
 *
 * The ring is drawn with border, not an SVG: one element, no extra request,
 * and it inherits --seal in both color schemes for free.
 */
interface Props {
  score: string;
}

const { score } = Astro.props;
---

<p class="score-mark">
  <span class="value" aria-hidden="true">{score}</span>
  {/* AT reads the full scale — a bare "8.3" is meaningless out of context. */}
  <span class="sr-only">평점 {score} / 10점 만점</span>
</p>

<style>
  .score-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border: 3px solid var(--seal);
    border-radius: 50%;
    margin: 0;
  }
  .value {
    font-family: var(--serif);
    font-size: var(--fs-29);
    font-weight: 700;
    line-height: 1;
    color: var(--seal);
    /* Tabular figures keep 8.3 and 10.0 optically centred in the ring. */
    font-variant-numeric: tabular-nums;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 640px) {
    .score-mark {
      width: 72px;
      height: 72px;
      border-width: 2px;
    }
    .value {
      font-size: var(--fs-21);
    }
  }
</style>
