---
/**
 * ScoreVerdict (components.md §9) — the magic moment. Fixed internal order:
 * seal rule → overline "평결" → score → badge (conditional) → listen links
 * (conditional). Placement invariant: AFTER the body only — putting this
 * before the body is a review reject (D2: the score is a conclusion).
 *
 * The score renders the STORED STRING verbatim ("8.3" stays "8.3", never
 * 8.30/8) — one of the five sanctioned --seal slots. Conditional rows that
 * have no data are NOT rendered (no empty shells, R-4).
 */
import type { ListenLink } from '../lib/listen-links.ts';
import FormatLabel from './FormatLabel.astro';
import NominateBadge from './NominateBadge.astro';

interface Props {
  score: string;
  listenLinks: ListenLink[];
  /** Present only while the album sits on the active board (SS-4 derive — W5.2 supplies). */
  nominate?: { bucketLabel: string; rank: number; year: number } | null;
}

const { score, listenLinks, nominate = null } = Astro.props;
---

<section class="verdict" aria-label="평결">
  <hr class="rule" aria-hidden="true" />
  <FormatLabel text="평결" />
  <p class="score-line">
    <span class="score">{score}</span><span class="denominator">/10</span>
  </p>
  {nominate && <NominateBadge bucketLabel={nominate.bucketLabel} rank={nominate.rank} year={nominate.year} />}
  {
    listenLinks.length > 0 && (
      <ul class="listen">
        {listenLinks.map((link) => (
          <li>
            {/* Same-tab outlink (a11y contract): no target=_blank, rel=noopener only. */}
            <a href={link.url} rel="noopener">
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .verdict {
    margin-top: var(--s-48);
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
    align-items: flex-start;
  }
  .rule {
    width: 48px;
    height: 2px;
    margin: 0;
    border: 0;
    background: var(--seal);
  }
  .score-line {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
  }
  /* Single large figure — serif is allowed here (no column alignment needed). */
  .score {
    font-family: var(--serif);
    font-size: var(--fs-42);
    font-weight: 700;
    line-height: 1.1;
    color: var(--seal);
  }
  .denominator {
    font-size: var(--fs-15);
    color: var(--muted);
  }
  .listen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-16);
  }
  .listen a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-15);
    color: var(--muted);
    transition: color var(--t-micro);
  }
  .listen a:hover {
    color: var(--seal);
  }
</style>
