---
/**
 * Footer (components.md §2): about/criteria + archive links, editor SNS
 * outlinks, ©. Single state.
 *
 * The © year is REPO-DERIVED (site.active_year), never new Date():
 * wall-clock values in page output are a determinism leak (R-10) that the
 * same-day double-build hash gate cannot catch — do not "fix" this back.
 * SNS links come from config when they exist; absent → not rendered (R-4).
 */
import { getSiteConfig } from '../lib/site.ts';
import { withBase } from '../lib/paths.ts';

const site = getSiteConfig();
---

<footer class="footer">
  <div class="footer-inner">
    <ul class="footer-nav">
      <li><a href={withBase('/about/')}>About</a></li>
      <li><a href={withBase('/archive/')}>Archive</a></li>
    </ul>
    <p class="copyright tnum">© {site.active_year} {site.site_name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    /* 96 → 64: the reskin tightens page rhythm everywhere except running
       prose, where the paragraph gap is deliberately untouched. */
    margin-top: var(--s-64);
  }
  .footer-inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: var(--s-32) 20px var(--s-48);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-16);
    flex-wrap: wrap;
  }
  .footer-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-24);
  }
  .footer-nav a {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.08em;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .footer-nav a:hover {
    color: var(--ink);
  }
  .copyright {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.04em;
    font-weight: 500;
    color: var(--muted);
  }
</style>
