---
/**
 * Footer (components.md §2, amended 2026-09-07): About + ©.
 *
 * WHY ABOUT IS DOWN HERE. The masthead carries the four content corners and
 * the archive; About is not a corner, it is the colophon — who is writing
 * this. Putting it at the foot is the ordinary place for that, and it frees
 * the masthead to be a list of things to read.
 *
 * WHAT LEFT, AND WHERE ONE OF IT WENT. The footer used to repeat About and
 * Archive from the masthead (a repeated destination costs a screen-reader
 * user a second reading and buys nothing), and it briefly carried the
 * album-cover rights contact as well. Archive stays in the masthead only.
 * The rights line is NOT gone from the site — it lives at the foot of
 * /about/ (ADR-0008 §4), one click from here on every page, which keeps the
 * path findable without putting a second sentence into the chrome.
 *
 * `current` comes down from Base so this link can carry aria-current on
 * /about/, exactly as a masthead item would.
 *
 * The © year is REPO-DERIVED (site.active_year), never new Date():
 * wall-clock values in page output are a determinism leak (R-10) that the
 * same-day double-build hash gate cannot catch — do not "fix" this back.
 */
import { getSiteConfig } from '../lib/site.ts';
import { withBase } from '../lib/paths.ts';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const site = getSiteConfig();
---

<footer class="footer">
  <div class="footer-inner">
    <a
      class:list={['footer-about', { current: current === 'about' }]}
      href={withBase('/about/')}
      aria-current={current === 'about' ? 'page' : undefined}>About</a
    >
    <p class="copyright tnum">© {site.active_year} {site.site_name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    /* 96 → 64: the reskin tightens page rhythm everywhere except running
       prose, where the paragraph gap is deliberately untouched. */
    margin-top: var(--s-64);
  }
  .footer-inner {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-32) 0 var(--s-48);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-16);
    flex-wrap: wrap;
  }
  /* Set like a masthead item, because it is one — just relocated. Current
     state is marked three ways (colour, weight, border) so it never depends
     on colour alone (WCAG 1.4.1), the same rule .nav-link follows. */
  .footer-about {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.08em;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 2px solid transparent;
    transition: color var(--t-micro), border-color var(--t-micro);
  }
  /* HOVER IS COLOUR ONLY (2026-09-07). The rule under this link used to
     light up on hover as well; it no longer does. What replaces it is the
     hue step --muted → --ink, which is a real change of state (a hovered
     link gets brighter), so the link still answers the pointer — an element
     that does nothing at all under the cursor stops reading as a link.
     What is NOT touched by this:
       · :focus-visible — the global 2px accent outline is the keyboard
         reader's only position indicator and is untouched here;
       · .current below — aria-current keeps its bar, so the page you are on
         is still marked three ways rather than by colour alone. */
  .footer-about:hover {
    color: var(--ink);
  }
  .footer-about.current {
    color: var(--ink);
    font-weight: 800;
    border-bottom-color: var(--accent);
  }
  .copyright {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.04em;
    font-weight: 500;
    color: var(--muted);
  }
</style>
