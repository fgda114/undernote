---
/**
 * ListRankRow (components.md §11) — list-page rows (top10 · monthly recap ·
 * finalized annual). BoardRow extended: 64px cover, display title, score
 * shown. Variant "champion" (finalized #1) upgrades the cover to 160px and
 * the title one step up the scale.
 * Invariant: display order = score order — guaranteed by the derive layer
 * (SS-8); this component provides no reordering UI.
 */
import CoverImage from './CoverImage.astro';
import { withBase } from '../lib/paths.ts';

interface Props {
  rank: number;
  title: string;
  artistsLabel: string;
  score: string;
  reviewUrl: string;
  cover: import('../lib/covers.ts').CoverSet | null;
  champion?: boolean;
}

const { rank, title, artistsLabel, score, reviewUrl, cover, champion = false } = Astro.props;
---

<li class:list={['rank-row', { champion, first: rank === 1 }]}>
  <a href={withBase(reviewUrl)} class="row-link">
    <span class="rank tnum" aria-hidden="true">{rank}</span>
    <CoverImage cover={cover} size={champion ? 160 : 64} albumTitle={title} />
    <span class="titles">
      <span class="title">{title}</span>
      <span class="artists">{artistsLabel}</span>
    </span>
    <span class="score tnum">{score}</span>
  </a>
</li>

<style>
  .rank-row {
    border-left: 3px solid transparent;
  }
  .rank-row.first {
    border-left-color: var(--accent);
  }
  .rank-row.first .rank {
    color: var(--accent-ink);
  }
  .row-link {
    display: flex;
    align-items: center;
    gap: var(--s-16);
    min-height: 72px;
    padding: var(--s-8) var(--s-12);
    transition: background var(--t-micro);
  }
  .champion .row-link {
    min-height: 176px;
  }
  .row-link:hover {
    background: var(--surface-2);
  }
  .row-link:hover .title {
    color: var(--accent-2-ink);
  }
  .rank {
    width: 28px;
    font-family: var(--mono);
    font-size: var(--fs-21);
    line-height: 24px;
    font-weight: 700;
    color: var(--muted);
    text-align: center;
    flex-shrink: 0;
  }
  .titles {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex-grow: 1;
  }
  .title {
    font-family: var(--display);
    font-size: var(--fs-21);
    line-height: 26px;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--ink);
    transition: color var(--t-micro);
  }
  .champion .title {
    font-size: var(--fs-27);
    line-height: 32px;
    font-weight: 800;
  }
  .artists {
    font-size: var(--fs-15);
    line-height: 22px;
    color: var(--muted);
  }
  .champion .artists {
    font-size: var(--fs-17);
    line-height: 24px;
  }
  .score {
    font-family: var(--mono);
    font-size: var(--fs-16);
    line-height: 20px;
    font-weight: 700;
    color: var(--ink);
    flex-shrink: 0;
  }
  .champion .score {
    font-size: var(--fs-21);
    line-height: 24px;
  }
  @media (max-width: 640px) {
    .rank {
      font-size: var(--fs-17);
      line-height: 20px;
    }
  }
</style>
