---
/**
 * Masthead (components.md §1): wordmark + 5-item nav. No scroll pinning —
 * long-form reading owns the viewport. The current page item is marked
 * THREE ways — accent border, ink color, weight 800 — so it never depends on
 * color alone (WCAG 1.4.1).
 *
 * Nav targets: /archive/ presets for Reviews/Notes (ui-spec §6), the active
 * year's list, the artist index, archive and about. Shell pages for these
 * routes are a W5.2 obligation (E-112 readiness).
 *
 * ORDER (revised 2026-09-07): Charts · Reviews · Notes · Artists · Archive.
 * The row now reads in the SAME order the home stacks its sections — Charts,
 * then Latest Reviews, then Notes — so a reader who scrolls the front page
 * and a reader who scans the nav are given the publication in one order
 * rather than two. Charts leads because the annual list is what this site is
 * for; the two formats follow; Artists is the people it writes about; and
 * Archive closes the row as the tool for finding any of them again.
 *
 * ABOUT IS NOT HERE. It moved to the footer: it is the colophon, not a
 * corner to read, and the masthead reads better as a list of things to read.
 * Artists WAS briefly cut on the argument that the archive reaches it — that
 * was reverted, because the archive reaches Reviews and Notes too, and
 * "reachable from the archive" would empty the masthead entirely. The
 * archive is where you look something up again; the masthead is the list of
 * corners.
 */
import { getSiteConfig } from '../lib/site.ts';
import { withBase } from '../lib/paths.ts';

interface Props {
  /** Which nav item is the current page (aria-current + visual state). */
  current?: 'reviews' | 'stories' | 'list' | 'artists' | 'archive' | 'about';
}

const { current } = Astro.props;
const site = getSiteConfig();

// Every href passes withBase — subpath deploys 404 otherwise (B-1).
const items = [
  { key: 'list', label: 'Charts', href: withBase(`/list/${site.active_year}/`) },
  { key: 'reviews', label: 'Reviews', href: withBase('/archive/reviews/') },
  { key: 'stories', label: 'Notes', href: withBase('/archive/stories/') },
  { key: 'artists', label: 'Artists', href: withBase('/artists/') },
  { key: 'archive', label: 'Archive', href: withBase('/archive/') },
] as const;
---

<header class="masthead">
  <nav aria-label="주 메뉴" class="masthead-inner">
    {/* Wordmark: display 800 + accent period. The period is the one physical
        survivor of the old ink-and-seal identity — the seal shrank to a dot. */}
    <a href={withBase('/')} class="wordmark">{site.site_name}<span class="wordmark-dot" aria-hidden="true">.</span></a>
    <ul class="nav-list">
      {
        items.map((item) => (
          <li>
            <a href={item.href} class:list={['nav-link', { current: current === item.key }]} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--line);
  }
  .masthead-inner {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    min-height: var(--masthead-h);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-16);
    flex-wrap: wrap; /* ~640px: two-row wrap allowed, no horizontal scroll */
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--fs-21);
    line-height: 24px;
    letter-spacing: -0.04em;
    color: var(--ink);
    /* 44px touch target via padding, not layout height */
    padding: var(--s-8) 0;
  }
  .wordmark-dot {
    color: var(--accent-ink);
  }
  /* ONE ROW, AND EVERY ITEM ON ONE LINE (2026-09-07).
     `align-items: center` and the flex <li> below are not cosmetic. Left to
     the defaults, each <li> is a block whose anchor is an INLINE-flex box, so
     the anchor's vertical position is resolved against the <li>'s text
     baseline — a number that comes from the font's metrics. That makes the
     row's alignment depend on which face actually rendered, which is exactly
     the kind of thing that differs between a machine where the subset webfont
     loaded and one where it did not. Measured on the shipped build the five
     items are identical to within 0.25px of painted ink at 1x, 2x and 4x, so
     this is not a repair of a visible defect; it removes the mechanism that
     could produce one. `display: flex` on the <li> deletes the line box, and
     `align-items: center` centres each item in the row's height instead of
     hanging it from a shared baseline. browser.a11y.spec.ts asserts the
     result across the audited widths. */
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-24);
  }
  .nav-list li {
    display: flex;
  }
  .nav-link {
    font-family: var(--mono);
    font-size: var(--fs-13);
    line-height: 16px;
    letter-spacing: 0.08em;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    /* The 2px rule is RESERVED SPACE, permanently transparent: the visible
       bar is the ::after below. Keeping the border means the row's height is
       identical in every state, so neither hovering nor landing on a page
       can shift the masthead by 2px (CLS stays 0). */
    border-bottom: 2px solid transparent;
    /* The bar is positioned against the padding box, which the transparent
       border sits just outside of — hence bottom: -2px below. */
    position: relative;
    transition: color var(--t-micro);
  }
  /* Hover underline, drawn from the CENTRE OUT. scaleX on a pseudo-element
     rather than an animated width/border: a transform is composited, so the
     bar cannot reflow the item it belongs to, and `transform-origin: center`
     is the whole of the "opens outwards from the middle" effect. The element
     is always in the box at scaleX(0) — nothing is created on hover, so
     there is nothing to lay out. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--line-strong);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--t-micro);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  /* Current page: THREE channels, unchanged in substance — ink colour,
     weight 800, and the bar — so the state never rests on colour alone
     (WCAG 1.4.1). The bar moved from border-bottom-color onto the same
     pseudo-element the hover uses, because two bars stacked in the same 2px
     of space would have hidden the accent under the hover grey. Declared
     AFTER the hover rule (equal specificity) so hovering the current item
     keeps the accent rather than repainting it. */
  .nav-link.current {
    color: var(--ink);
    font-weight: 800;
  }
  .nav-link.current::after {
    background: var(--accent);
    transform: scaleX(1);
  }
  /* Reduced motion: the underline still APPEARS — removing the state
     indicator would be a worse answer than removing the animation — it just
     arrives at full width instead of growing to it. The global rule in
     global.css already collapses the duration; this states the intent
     locally so a later edit to that rule cannot silently reintroduce the
     sweep here. */
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
  @media (max-width: 640px) {
    .masthead-inner {
      min-height: var(--masthead-h-mobile);
    }
    /* FIVE ITEMS, ONE LINE, DOWN TO 360px (2026-09-07). The row used to wrap:
       ARCHIVE dropped to a second line at 360 and ARTISTS joined it below
       ~345, which turned the site's whole navigation into a two-storey block
       above every mobile page.
       WHAT WAS TRADED, MEASURED at 360px (content 320px, nav on its own row
       under the wordmark). The row is 393.2px wide at the desktop values:
         · tracking 0.08em → 0.04em  −16.6px   (0.04em is the value .date and
           the footer's © already use, so no new number entered the system)
         · gap 24px → 8px            −64px
         = 312.6px, which fits with 7.4px to spare.
       WHAT WAS NOT TRADED. The type SIZE is untouched — a nav item is the
       same object here as at 1440, and shrinking it would have been the
       cheapest 20px and the most visible loss. Touch targets stay whole: the
       narrowest item (NOTES) measures 45.4 x 44, so every item clears 44px in
       BOTH axes, not just the padded height.
       `flex-wrap: wrap` stays on the list above and is the point: below
       ~345px the row wraps again rather than overflowing, so the 360px
       horizontal-scroll contract holds by construction and a font that
       renders wider than the subset degrades into a second line instead of a
       scrollbar. */
    .nav-list {
      gap: var(--s-8);
    }
    .nav-link {
      letter-spacing: 0.04em;
    }
  }
</style>
