---
/**
 * Masthead (components.md §1): wordmark + 5-item nav. No scroll pinning —
 * long-form reading owns the viewport. The current page item is marked with
 * ink weight + a 2px bottom border (never color alone — WCAG 1.4.1).
 *
 * Nav targets: /archive/ presets for 평론/이야기 (ui-spec §6), the active
 * year's list, archive and about. Shell pages for these routes are a W5.2
 * obligation (E-112 readiness).
 */
import { getSiteConfig } from '../lib/site.ts';
import { withBase } from '../lib/paths.ts';

interface Props {
  /** Which nav item is the current page (aria-current + visual state). */
  current?: 'reviews' | 'stories' | 'list' | 'archive' | 'about';
}

const { current } = Astro.props;
const site = getSiteConfig();

// Every href passes withBase — subpath deploys 404 otherwise (B-1).
const items = [
  { key: 'reviews', label: '평론', href: withBase('/archive/reviews/') },
  { key: 'stories', label: '이야기', href: withBase('/archive/stories/') },
  { key: 'list', label: '올해의앨범', href: withBase(`/list/${site.active_year}/`) },
  { key: 'archive', label: '아카이브', href: withBase('/archive/') },
  { key: 'about', label: '소개', href: withBase('/about/') },
] as const;
---

<header class="masthead">
  <nav aria-label="주 메뉴" class="masthead-inner">
    {/* Wordmark: serif 700 + seal period — text logo, single replacement point. */}
    <a href={withBase('/')} class="wordmark">{site.site_name}<span class="wordmark-dot" aria-hidden="true">.</span></a>
    <ul class="nav-list">
      {
        items.map((item) => (
          <li>
            <a href={item.href} class:list={['nav-link', { current: current === item.key }]} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--line);
  }
  .masthead-inner {
    max-width: 960px;
    margin: 0 auto;
    min-height: var(--masthead-h);
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-16);
    flex-wrap: wrap; /* ~640px: two-row wrap allowed, no horizontal scroll */
  }
  .wordmark {
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--fs-21);
    /* 44px touch target via padding, not layout height */
    padding: var(--s-8) 0;
  }
  .wordmark-dot {
    color: var(--seal);
  }
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-16);
  }
  .nav-link {
    font-size: var(--fs-15);
    font-weight: 600;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 2px solid transparent;
    transition: color var(--t-micro);
  }
  .nav-link:hover {
    color: var(--seal);
  }
  .nav-link.current {
    font-weight: 700;
    border-bottom-color: var(--ink);
  }
  @media (max-width: 640px) {
    .masthead-inner {
      min-height: var(--masthead-h-mobile);
    }
  }
</style>
