---
/**
 * BoardRow (components.md §9) — one bucket row inside BoardPanel, rendered
 * on /list/{year}/'s progressive-year genre nominees (the home switched to
 * ChartCard's grid 2026-09-07 and no longer uses this component). The whole
 * <li> is one link (US-2: one click to the review). Variant "first" (#1)
 * gets the mint rank + a 3px left border — three signals for one fact
 * (color, the rank NUMBER, the border), never color alone (WCAG 1.4.1).
 *
 * Score renders the stored string verbatim, tabular, and as the only text
 * node of its span — the dist tests locate scores as `>8.3<`.
 */
import type { ListEntry } from '../lib/derive/lists.ts';
import CoverImage from './CoverImage.astro';
import { withBase } from '../lib/paths.ts';

interface Props {
  entry: ListEntry;
  rank: number;
}

const { entry, rank } = Astro.props;
---

<li class:list={['board-row', { first: rank === 1 }]}>
  <a href={withBase(entry.review_url)} class="row-link">
    <span class="rank tnum" aria-hidden="true">{rank}</span>
    <CoverImage cover={entry.cover} size={48} albumTitle={entry.title} />
    <span class="titles">
      <span class="title">{entry.title}</span>
      <span class="artists">{entry.artists_label}</span>
    </span>
    <span class="score tnum">{entry.score}</span>
  </a>
</li>

<style>
  .board-row {
    border-left: 3px solid transparent;
  }
  .board-row.first {
    border-left-color: var(--accent);
  }
  .board-row.first .rank {
    color: var(--accent-ink);
  }
  .row-link {
    display: flex;
    align-items: center;
    gap: var(--s-12);
    min-height: 56px;
    padding: var(--s-8) var(--s-12);
    transition: background var(--t-micro);
  }
  .row-link:hover {
    background: var(--surface-2);
  }
  .row-link:hover .title {
    color: var(--accent-2-ink);
  }
  .rank {
    width: 20px;
    font-family: var(--mono);
    font-size: var(--fs-15);
    line-height: 20px;
    font-weight: 700;
    color: var(--muted);
    text-align: center;
    flex-shrink: 0;
  }
  .titles {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex-grow: 1;
  }
  .title {
    font-size: var(--fs-16);
    line-height: 22px;
    letter-spacing: -0.01em;
    font-weight: 700;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--t-micro);
  }
  .artists {
    font-size: var(--fs-14);
    line-height: 20px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .score {
    font-family: var(--mono);
    font-size: var(--fs-15);
    line-height: 20px;
    font-weight: 700;
    color: var(--ink);
    flex-shrink: 0;
  }
</style>
