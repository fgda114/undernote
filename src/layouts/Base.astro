---
/**
 * Base layout — document skeleton + the OG injection point every public page
 * shares (api-contracts §5: og:title/description/image + og:type/og:url/
 * twitter:card are mandatory on every page — E-111 enforces this in W5.2).
 *
 * Score strings NEVER pass through here: OG assembly input types have no
 * score field at all (E-115 is enforced at the type level, src/lib/og).
 *
 * CLIENT JS: "zero" became "a budget" on 2026-09-07 (lead decision). Exactly
 * ONE inline module ships, from this file, under the ceiling in
 * build.dist-matrix.spec.ts (2560B; the block measures 2544B), and it does
 * three things — two decorative, one functional (the archive search filter,
 * 2026-09-09). What replaced the old zero as the guard is measured, not
 * assumed — build.dist-matrix.spec.ts fails the build if any page carries
 * more than one script tag, if any script has a src, or if the inline body
 * exceeds the byte budget; browser.flows.spec.ts still proves that no
 * JavaScript is fetched over the network, and additionally renders the site
 * with scripting disabled. Read the full reasoning in
 * 08-impl-notes/frontend.md before adding a second one.
 *
 * THE MODULE'S TEXT NOW LIVES IN src/scripts/enhance.js, not between the
 * <script> tags below. That move bought one property and cost nothing else:
 * the CSP hash in <head> and the bytes at the end of <body> are produced
 * from the SAME string in the same render, so they cannot drift apart. See
 * lib/csp.ts for why the hash may never be taken from dist.
 */
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import { absoluteUrl, getSiteConfig } from '../lib/site.ts';
import { cspContent, enhanceJs } from '../lib/csp.ts';
import { ogImageUrl } from '../lib/og/version.ts';
import { withBase } from '../lib/paths.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** og:type — "article" for reviews/stories, "website" otherwise. */
  ogType?: 'website' | 'article';
  /** Site-relative path of the page's share card (task: OG generator). */
  ogImage?: string;
  /** Site-relative canonical path of this page, e.g. "/reviews/foo/". */
  path: string;
  current?: 'reviews' | 'stories' | 'list' | 'artists' | 'archive' | 'about';
  /**
   * Preload the serif faces. Since the 2026-09 reskin the serif is used by
   * exactly two surfaces — review bodies and the finalized annual preface —
   * so every other page would otherwise pay 322.1KB for a face it never
   * paints. The @font-face declarations stay global (a declaration alone
   * downloads nothing); only the preload hint is conditional.
   */
  preloadSerif?: boolean;
}

const site = getSiteConfig();
const { title, description, ogType = 'website', ogImage = '/og/default.png', path, current, preloadSerif = false } = Astro.props;
const goatcounter = site.goatcounter_code;
const fullTitle = title === site.site_name ? title : `${title} — ${site.site_name}`;

// @font-face lives HERE, not in global.css: CSS cannot apply the deploy base
// to url() and Astro inlines the stylesheet, so root-relative font URLs
// would 404 under a subpath deploy (B-1 class). Computed with withBase.
const fontFaceCss = `
@font-face{font-family:'Pretendard Variable';src:url('${withBase('/fonts/PretendardVariable-sub.woff2')}') format('woff2-variations');font-weight:45 920;font-display:swap}
@font-face{font-family:'Noto Serif KR';src:url('${withBase('/fonts/NotoSerifKR-400-sub.woff2')}') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Noto Serif KR';src:url('${withBase('/fonts/NotoSerifKR-700-sub.woff2')}') format('woff2');font-weight:700;font-display:swap}`;

// Content-Security-Policy for this page, derived from the same module
// string that is emitted at the end of <body>. E-117 re-checks the pairing
// against the built file, so a refactor that breaks it fails the build
// instead of shipping a policy that blocks the site's own script.
const csp = cspContent(goatcounter);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* As early in <head> as the charset allows: a meta CSP only governs what
        the parser reaches AFTER it, and the site's own script sits at the end
        of <body>. Everything between here and there is markup, not script. */}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={absoluteUrl(path)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {/* ?v=… busts the share platforms' image cache when the card DESIGN
        changes — they key on the URL and will otherwise serve a card scraped
        months ago. The version is a hash of the OG library's source, so it
        moves by itself and only when the drawing code moves; the reasoning,
        and what it deliberately does not catch, is in lib/og/version.ts. */}
    <meta property="og:image" content={ogImageUrl(absoluteUrl(ogImage))} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={absoluteUrl(path)} />
    <meta property="og:site_name" content={site.site_name} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Pretendard paints the wordmark and every headline, so it is always
        preloaded; the serif only on the two pages that actually set prose in it. */}
    <link rel="preload" href={withBase('/fonts/PretendardVariable-sub.woff2')} as="font" type="font/woff2" crossorigin />
    {
      preloadSerif && (
        <>
          <link rel="preload" href={withBase('/fonts/NotoSerifKR-400-sub.woff2')} as="font" type="font/woff2" crossorigin />
          <link rel="preload" href={withBase('/fonts/NotoSerifKR-700-sub.woff2')} as="font" type="font/woff2" crossorigin />
        </>
      )
    }
    <Fragment set:html={`<style>${fontFaceCss}</style>`} />
  </head>
  <body>
    <Masthead current={current} />
    <slot />
    <Footer current={current} />
    {/* The site's ONE script. Two decorations plus one functional feature
        (archive search, 2026-09-09). The two decorations are progressive
        enhancement in the strict sense: everything they touch already works
        without them — the chart pager arrows are in-page links to the first
        and last card, and the cover hover zoom is pure CSS. Search is
        DIFFERENT IN KIND, and said so plainly rather than squeezed into the
        old claim: it DOES hide rows and relabel a live count, so a reader
        without JavaScript is not merely missing an effect there — they are
        missing the FILTER. What they are not missing is the FEATURE the
        filter narrows: /archive/ already renders every article server-side
        (see that page's own intro for why "the hub is the index" removes the
        need for a fetched search index), so JS off leaves the full, real
        archive — nothing is stubbed out waiting for a script, there is just
        one fewer way to narrow it. That is also why there is still no
        <noscript> counterpart: a query box with nothing to say when it
        cannot run would be exactly the self-narrating sentence this site's
        empty states already gave up (SectionEmpty's intro). Its text is
        src/scripts/enhance.js, emitted verbatim below; that file's comments
        are DEPLOY BYTES (nothing minifies them), which is why the long-form
        reasoning stays here where it costs nothing and the file itself
        carries one pointer line. Ship budget: that file is the whole of it —
        2544B against 2560B. The ceiling has moved four times — 1KB → 2KB
        when the pager arrived, 2048B → 2304B when the tracking grew from one
        reader to three, back DOWN to 2048B when two of those three readers
        were withdrawn, and 2048B → 2560B when the search filter arrived (a
        third, FUNCTIONAL reader of the budget, decided at the lead level
        rather than shaved to fit) — and each move is recorded with its
        reason in build.dist-matrix.spec.ts, which holds the number and fails
        the build when a feature outgrows it. A ceiling left standing above a
        payload that shrank is not a budget.

        THE ARCHIVE SEARCH reads `data-s` off every row already in the DOM
        (lib/derive/archive.ts#deriveHubIndex builds that string once, at
        build time — the ONE definition of "matches" this feature has) and
        does a plain case-insensitive substring test against the query box's
        value on every `input` event. No debounce: the rich sandbox's row
        count is small enough that a naive full-list scan on every keystroke
        is imperceptible, and adding one would be a second thing to get
        wrong for a cost that has not been measured as real. Matching rows
        stay in the DOM and get `hidden = false`; the rest get `hidden =
        true`, which is a real UA-level display:none — a screen reader and
        the tab order both skip them, not just sighted scrolling. The live
        count (`aria-live="polite"`) is the only other thing the listener
        touches, so the whole feature is one element read, one event
        listener, and two writes per row.

        THE PAGER never creates a control. The arrows are anchors in the
        HTML, so a reader without JavaScript gets "jump to the start / to the
        end" instead of "step one screen" — less, but never a dead button.
        aria-disabled is advisory only: the link stays operable, it simply
        has nowhere left to go, and it is marked dimmed AND announced so the
        state is never carried by colour alone.

        THE CURSOR TRACKING passes three gates before a single listener
        exists:
          · a fine hovering pointer — a touch device has no cursor to follow,
            and attaching pointermove there would burn battery for nothing;
          · prefers-reduced-motion — refused at the ENTRY POINT, not merely
            hidden in CSS, so the work is never even scheduled;
          · a tracked box under the pointer — a .cover-frame or a home
            browsing card (.card-link) — otherwise pointermove returns on its
            first line.

        ONE READER LEFT, AND THE ROOT IS STILL WHERE THE MEASUREMENT GOES
        (2026-09-07). The card title's mint spotlight was withdrawn, so the
        cover zoom is now the only rule that reads --px/--py. Writing them on
        :root rather than on the tracked element is kept anyway: it costs
        nothing (only a hovered anchor has a rule that reads them), it is
        what let one listener serve two effects while there were two, and
        moving the write onto the element would be a second edit with no
        reader asking for it.
        TWO BOXES, ONE MEASUREMENT, and `closest` returning the INNERMOST
        match is what keeps them from fighting: over the cover the travel is
        measured inside the cover, over the rest of the card it is measured
        against the card. The second case is looser rather than wrong — the
        art drifts from card-relative coordinates — and the ±0.5 clamp keeps
        it inside the frame either way.

        No layout thrash: the frame is measured ONCE per enter, writes are
        coalesced into one rAF, and the only thing written is two custom
        properties that CSS turns into a composited transform. Every listener
        in the module is passive except the pager's click, so nothing here
        can block scrolling.

        Values are clamped to ±0.5. The measured box goes stale if the page
        scrolls while the pointer sits still on a cover; the clamp bounds how
        wrong the result can be, and the effect is decorative enough that
        re-measuring on scroll would cost more than it is worth. */}
    {/* Emitted RAW from the same string the CSP hash was taken from —
        set:html is how this layout already ships the @font-face block. Astro
        renders it verbatim, so dist carries the module byte for byte and the
        hash in <head> matches by construction rather than by discipline. */}
    <Fragment set:html={`<script type="module">${enhanceJs()}</script>`} />
    {
      /* Analytics — the only EXTERNAL script this site may load (ADR-0002):
         OPT-IN via config/site.yaml#goatcounter_code; absent = zero scripts.
         Do not remove as a cleanup — charter §3 requires measured
         referral/dwell data and the performance-budget reset depends on it
         (lead decision 2026-09-02, recorded in api-contracts §3.8).
         Turning it on puts a SECOND script tag on every page. E-116 and the
         CSP both already know about exactly this one and widen by exactly
         this one (lib/csp.ts, checker/postbuild.ts); the e2e budget test
         still asserts one tag per page and will fail until it is taught —
         that is deliberate: the budget should notice a change of that size.
         GoatCounter: cookieless, no GDPR banner, ~3.5KB. HTTPS explicit —
         protocol-relative URLs are obsolete and break file:// viewing. */
      goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"></script>
      )
    }
  </body>
</html>
