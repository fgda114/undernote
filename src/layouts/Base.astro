---
/**
 * Base layout — document skeleton + the OG injection point every public page
 * shares (api-contracts §5: og:title/description/image + og:type/og:url/
 * twitter:card are mandatory on every page — E-111 enforces this in W5.2).
 *
 * Score strings NEVER pass through here: OG assembly input types have no
 * score field at all (E-115 is enforced at the type level, src/lib/og).
 */
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import { absoluteUrl, getSiteConfig } from '../lib/site.ts';
import { withBase } from '../lib/paths.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** og:type — "article" for reviews/stories, "website" otherwise. */
  ogType?: 'website' | 'article';
  /** Site-relative path of the page's share card (task: OG generator). */
  ogImage?: string;
  /** Site-relative canonical path of this page, e.g. "/reviews/foo/". */
  path: string;
  current?: 'reviews' | 'stories' | 'list' | 'archive' | 'about';
}

const site = getSiteConfig();
const { title, description, ogType = 'website', ogImage = '/og/default.png', path, current } = Astro.props;
const goatcounter = site.goatcounter_code;
const fullTitle = title === site.site_name ? title : `${title} — ${site.site_name}`;

// @font-face lives HERE, not in global.css: CSS cannot apply the deploy base
// to url() and Astro inlines the stylesheet, so root-relative font URLs
// would 404 under a subpath deploy (B-1 class). Computed with withBase.
const fontFaceCss = `
@font-face{font-family:'Pretendard Variable';src:url('${withBase('/fonts/PretendardVariable-sub.woff2')}') format('woff2-variations');font-weight:45 920;font-display:swap}
@font-face{font-family:'Noto Serif KR';src:url('${withBase('/fonts/NotoSerifKR-400-sub.woff2')}') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Noto Serif KR';src:url('${withBase('/fonts/NotoSerifKR-700-sub.woff2')}') format('woff2');font-weight:700;font-display:swap}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={absoluteUrl(path)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteUrl(ogImage)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={absoluteUrl(path)} />
    <meta property="og:site_name" content={site.site_name} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Fonts are small subsets; preloading the two first-paint faces avoids FOUT on the wordmark. */}
    <link rel="preload" href={withBase('/fonts/NotoSerifKR-700-sub.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/fonts/PretendardVariable-sub.woff2')} as="font" type="font/woff2" crossorigin />
    <Fragment set:html={`<style>${fontFaceCss}</style>`} />
  </head>
  <body>
    <Masthead current={current} />
    <slot />
    <Footer />
    {
      /* Analytics — the ONE sanctioned exception to "client JS 0" (ADR-0002):
         OPT-IN via config/site.yaml#goatcounter_code; absent = zero scripts.
         Do not remove as a "JS 0" cleanup — charter §3 requires measured
         referral/dwell data and the performance-budget reset depends on it
         (lead decision 2026-09-02, recorded in api-contracts §3.8).
         GoatCounter: cookieless, no GDPR banner, ~3.5KB. HTTPS explicit —
         protocol-relative URLs are obsolete and break file:// viewing. */
      goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"></script>
      )
    }
  </body>
</html>
