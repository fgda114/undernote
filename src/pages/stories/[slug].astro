---
/**
 * /stories/{slug}/ — music story page, full form (ui-spec §3 · CF-5).
 * Display head (34/800) and SANS body — after the reskin moved every
 * headline to the display face, the sans/serif body split is the whole of
 * the tone separation from reviews (charter §4), so it stays.
 *
 * In-body album links: the body is pure markdown the editor wrote — links
 * already present render as-is; there is NO automatic name-matching
 * (mismatch risk, and US-4 AC1 is satisfied by the AlbumBox links — W3
 * interpretation recorded in the story file). Ends with AlbumBox (plan A —
 * the confirmed default; LineageBlock stays a standby contract until the
 * editor picks plan B).
 */
import { getCollection, render } from 'astro:content';
import AdjacentNav from '../../components/AdjacentNav.astro';
import AlbumBox from '../../components/AlbumBox.astro';
import FormatLabel from '../../components/FormatLabel.astro';
import Base from '../../layouts/Base.astro';
import { excerptFrom } from '../../lib/derive/excerpt.ts';
import { deriveAlbumBoxRows } from '../../lib/derive/links.ts';
import { getSiteData } from '../../lib/derive/site-data.ts';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const description = excerptFrom(story.body ?? '');
const siteData = getSiteData();
const albumRows = deriveAlbumBoxRows(story.data, siteData.data);
// Prev/Next (2026-09-09) — within stories only, see
// lib/derive/lists.ts#deriveAdjacentMap for the order this follows. The
// `?? {…}` fallback mirrors reviews/[slug].astro's own — see that page's
// comment for why a missing map entry is possible and why R-4 (render
// nothing, never crash) is the right response to it.
const { prev, next } = siteData.adjacent.get(`/stories/${story.id}/`) ?? { prev: null, next: null };
---

<Base
  title={story.data.title}
  description={description}
  ogType="article"
  path={`/stories/${story.id}/`}
  current="stories"
>
  <main>
    <article>
      <header class="hero">
        <FormatLabel text="Notes" />
        <h1 class="title">{story.data.title}</h1>
        <time class="date tnum" datetime={story.data.date}>{story.data.date}</time>
      </header>
      {/* One shell frame for the body and its tail so every block lands on
          the same grid line as the header above (layouts.md §4.1). */}
      <div class="story-main">
        <div class="prose story-body">
          <Content />
        </div>
        {
          albumRows.length > 0 && (
            <div class="column">
              <AlbumBox rows={albumRows} />
            </div>
          )
        }
        <div class="column">
          <AdjacentNav prev={prev} next={next} />
        </div>
      </div>
    </article>
  </main>
</Base>

<style>
  .hero {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-12);
  }
  .title {
    font-family: var(--display);
    font-size: var(--fs-34);
    line-height: 40px;
    letter-spacing: -0.025em;
    font-weight: 800;
    text-wrap: balance;
  }
  .date {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.04em;
    font-weight: 500;
    color: var(--muted);
  }
  .story-main {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: 0;
  }
  .column,
  .story-body {
    max-width: var(--column);
  }
  .story-body {
    margin-top: var(--s-32);
    font-family: var(--sans);
    font-size: var(--fs-17);
    line-height: 1.8;
    letter-spacing: -0.003em;
  }
  .story-body :global(p) {
    margin: 0 0 var(--s-24);
  }
  .story-body :global(h2) {
    font-family: var(--sans);
    font-size: var(--fs-21);
    line-height: 30px;
    letter-spacing: -0.005em;
    font-weight: 700;
    color: var(--ink);
    margin: var(--s-32) 0 var(--s-16);
  }
  .story-body :global(blockquote) {
    margin: 0 0 var(--s-24);
    padding-left: var(--s-16);
    border-left: 2px solid var(--line-strong);
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: var(--s-32);
    }
    .title {
      font-size: var(--fs-27);
      line-height: 32px;
      letter-spacing: -0.02em;
    }
    .story-body {
      line-height: 1.75;
    }
  }
</style>
