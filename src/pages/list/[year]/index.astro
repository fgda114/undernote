---
/**
 * /list/{year}/ — annual list (ui-spec §4).
 *
 * Two mutually exclusive renders decided by data, not by clock:
 *  - FINALIZED: a snapshot for {year} exists → render ONLY the frozen
 *    snapshot (titles/labels/scores denormalized at finalize time — later
 *    config or score edits cannot reach this page, R-8). Preface (editor's
 *    markdown) above the list (US-1 AC3). Title never hardcodes a count —
 *    the caption carries "{n}장의 앨범" automatically (R-6).
 *  - PROGRESSIVE: {year} is the active year → live top10 + bucket boards.
 * Covers are display-time lookups by slug (covers aren't frozen data).
 *
 * Both faces carry the SAME h1, "{year} 올해의 앨범", and the SAME overline,
 * "Charts". Neither repeats the other: the overline names the section (the
 * masthead item the reader clicked), the h1 names the year.
 *
 * A finalized year is marked by a `.finalized-mark` chip beside the overline
 * and by the caption underneath, which the progressive face does not have at
 * all. The overline used to carry "{year} 올해의 앨범 — 확정", which printed
 * the page's own title twice, one line apart; the mark says the only part of
 * that string the h1 was not already saying.
 */
import { getEntry, render } from 'astro:content';
import FormatLabel from '../../../components/FormatLabel.astro';
import BoardPanel from '../../../components/BoardPanel.astro';
import ListRankRow from '../../../components/ListRankRow.astro';
import Base from '../../../layouts/Base.astro';
import { coverSetFor } from '../../../lib/covers.ts';
import { getSiteData } from '../../../lib/derive/site-data.ts';
import { withBase } from '../../../lib/paths.ts';

export async function getStaticPaths() {
  const { site, snapshotYears } = getSiteData();
  const years = [...new Set([site.active_year, ...snapshotYears])];
  return years.map((year) => ({ params: { year: String(year) } }));
}

const year = Number(Astro.params.year);
const { site, board, top10, data } = getSiteData();
const snapshot = data.snapshots.find((s) => s.data.year === year);

const albumCovers = new Map(data.albums.map((a) => [a.slug, a.data.cover]));
const coverFor = (slug: string, title: string, artistsLabel: string) =>
  coverSetFor({ slug, title, artistsLabel, cover: albumCovers.get(slug) });

// Finalized page data (frozen strings straight from the snapshot).
let Preface: Awaited<ReturnType<typeof render>>['Content'] | null = null;
if (snapshot) {
  const entry = await getEntry('snapshots', String(year));
  if (entry && (entry.body ?? '').trim().length > 0) {
    Preface = (await render(entry)).Content;
  }
}
const publishedBuckets = snapshot ? snapshot.data.buckets.filter((b) => b.published) : [];
const previousSnapshot = data.snapshots.find((s) => s.data.year === year - 1);
---

<Base
  title={`${year} 올해의 앨범`}
  description={snapshot ? `${snapshot.data.finalized_at}에 확정된 ${year} 올해의 앨범.` : `${year} 올해의 앨범 — 현재 노미네이트.`}
  path={`/list/${year}/`}
  ogImage={`/og/list/${year}.png`}
  current="list"
  preloadSerif={Preface != null}
>
  <main class="list-page">
    <header class="head">
      {/* The English section name, the same pairing the masthead and the
          home's Charts head use (Charts over the real heading) — plus a
          state chip when the year is frozen. See the intro for why the
          overline no longer restates the title. */}
      <div class="overline">
        <FormatLabel text="Charts" />
        {snapshot && <span class="finalized-mark">확정</span>}
      </div>
      {/* `head-sheen` (global.css) — the second and last heading allowed the
          gradient display treatment. This page IS the list the scores
          produced, which is what --accent is reserved for (tokens.css). */}
      <h1 class="page-title head-sheen">{`${year} 올해의 앨범`}</h1>
      {
        /* The progressive year has no caption (2026-09-07). "진행 중인 한 해"
           and "이 리스트는 평론이 쌓일 때마다 바뀝니다. 12월에 확정됩니다."
           were cut for the same reason the home's progress strip was: they
           narrate the publication's own state instead of the year's records,
           and a reader who has just clicked "올해의 앨범" is here for the
           albums. The overline already says whether the year is 확정, and the
           section headings below say whether they are 노미네이트 or 선정 — the
           page's structure carries what the sentence was carrying.
           The finalized caption STAYS: it is not about progress, it is the
           immutability contract (R-8) plus the count R-6 forbids hardcoding
           into the title. */
        snapshot && (
          <p class="caption">
            {`${snapshot.data.finalized_at}에 확정된 리스트입니다. 이후의 평론·수정은 여기 반영되지 않습니다. ${snapshot.data.top10.length}장의 앨범.`}
          </p>
        )
      }
    </header>

    {
      snapshot ? (
        <>
          {Preface && (
            <section class="preface prose">
              <Preface />
            </section>
          )}
          <section aria-label={`${year} 올해의 앨범`}>
            <ol class="rows">
              {snapshot.data.top10.map((entry) => (
                <ListRankRow
                  rank={entry.rank}
                  title={entry.title}
                  artistsLabel={entry.artists_label}
                  score={entry.score}
                  reviewUrl={`/reviews/${entry.album}/`}
                  cover={coverFor(entry.album, entry.title, entry.artists_label)}
                  champion={entry.rank === 1}
                />
              ))}
            </ol>
          </section>
          {publishedBuckets.length > 0 && (
            <section class="buckets" aria-label="장르별 선정">
              <h2 class="section-title">장르별 선정</h2>
              {publishedBuckets.map((bucket) => (
                <div class="bucket">
                  <h3 class="bucket-label">{bucket.label}</h3>
                  <ol class="rows">
                    {(bucket.nominees ?? []).map((n, i) => (
                      <ListRankRow
                        rank={i + 1}
                        title={n.title}
                        artistsLabel={n.artists_label}
                        score={n.score}
                        reviewUrl={`/reviews/${n.album}/`}
                        cover={coverFor(n.album, n.title, n.artists_label)}
                      />
                    ))}
                  </ol>
                </div>
              ))}
            </section>
          )}
        </>
      ) : (
        <>
          {top10.entries.length > 0 && (
            <section aria-label="올해의 앨범 후보">
              <h2 class="section-title">올해의 앨범 후보 — 현재 상위 {top10.entries.length}</h2>
              <ol class="rows">
                {top10.entries.map((entry, i) => (
                  <ListRankRow
                    rank={i + 1}
                    title={entry.title}
                    artistsLabel={entry.artists_label}
                    score={entry.score}
                    reviewUrl={entry.review_url}
                    cover={entry.cover}
                  />
                ))}
              </ol>
            </section>
          )}
          <section class="buckets" aria-label="장르별 노미네이트">
            <h2 class="section-title">장르별 노미네이트</h2>
            <div class="bucket-grid">
              {board.buckets.map((bucket) => (
                <BoardPanel bucket={bucket} />
              ))}
            </div>
          </section>
          {previousSnapshot && (
            <a class="tail-link" href={withBase(`/list/${year - 1}/`)}>지난해 확정 리스트 →</a>
          )}
        </>
      )
    }
  </main>
</Base>

<style>
  .list-page {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-48);
  }
  /* Size and weight come from the shared .page-title (global.css); only the
     spacing this page needs is local. */
  .page-title {
    margin-top: var(--s-12);
    text-wrap: balance;
  }
  .overline {
    display: flex;
    align-items: center;
    gap: var(--s-8);
  }
  /* A neutral chip, not an accent plate. The accent means "the score made
     this", and while a finalized list IS the scores' final output, the page
     already spends its accent budget on the champion row's rank and rail;
     a second filled block would halve that one's weight (the same reason
     NominateBadge is an outline). --ink on --surface-3 is 12.48:1. */
  .finalized-mark {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--s-8);
    min-height: 20px;
    background: var(--surface-3);
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: var(--label-ls-ko);
    font-weight: 700;
  }
  .caption {
    margin-top: var(--s-8);
    font-size: var(--fs-14);
    line-height: 20px;
    color: var(--muted);
  }
  /* The preface is the editor's own writing about the year — one of the two
     surfaces where the serif survived the reskin (the other is review bodies). */
  .preface {
    max-width: var(--column);
    font-family: var(--serif);
    font-size: var(--fs-17);
    line-height: 1.85;
  }
  .preface :global(p) {
    margin: 0 0 var(--s-24);
  }
  .section-title {
    font-family: var(--display);
    font-size: var(--fs-21);
    line-height: 26px;
    letter-spacing: -0.01em;
    font-weight: 800;
    margin-bottom: var(--s-16);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bucket {
    margin-top: var(--s-24);
  }
  .bucket-label {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: var(--label-ls-ko);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: var(--s-8);
  }
  .bucket-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--s-16);
  }
  .tail-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-15);
    line-height: 20px;
    font-weight: 600;
  }
  .tail-link:hover {
    color: var(--accent-2-ink);
  }
  @media (max-width: 640px) {
    .list-page {
      padding-top: var(--s-32);
    }
  }
</style>
