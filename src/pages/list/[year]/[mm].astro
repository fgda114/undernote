---
/**
 * /list/{year}/{mm}/ — monthly recap (ui-spec §5 · SS-7). Publication-month
 * attribution (old albums included — R-3), ENDED months only, zero-review
 * months simply have no page (R-4). A living derivation: later score edits
 * re-derive past months (R-5). This page is the community-distribution unit
 * — its OG card carries the month's top 1~3.
 */
import FormatLabel from '../../../components/FormatLabel.astro';
import ListRankRow from '../../../components/ListRankRow.astro';
import Base from '../../../layouts/Base.astro';
import { getSiteData } from '../../../lib/derive/site-data.ts';
import type { MonthlyRecap } from '../../../lib/derive/lists.ts';

export async function getStaticPaths() {
  const { recaps } = getSiteData();
  return recaps.map((recap) => {
    const [year, mm] = recap.month.split('-');
    return { params: { year, mm }, props: { recap } };
  });
}

const { recap } = Astro.props as { recap: MonthlyRecap };
const [year, mm] = recap.month.split('-');
const monthNum = Number(mm);
---

<Base
  title={`${year}년 ${monthNum}월의 앨범`}
  description={`${monthNum}월에 발행된 평론 ${recap.entries.length}편, 점수순.`}
  path={`/list/${year}/${mm}/`}
  ogImage={`/og/list/${year}-${mm}.png`}
  current="list"
>
  <main class="recap">
    <header>
      <FormatLabel text={`${year} 월말정산`} />
      <h1 class="title">{monthNum}월의 앨범</h1>
      <p class="caption">{monthNum}월에 발행된 평론 {recap.entries.length}편, 점수순.</p>
    </header>
    <ol class="rows">
      {
        recap.entries.map((entry, i) => (
          <ListRankRow
            rank={i + 1}
            title={entry.title}
            artistsLabel={entry.artists_label}
            score={entry.score}
            reviewUrl={entry.review_url}
            cover={entry.cover}
          />
        ))
      }
    </ol>
  </main>
</Base>

<style>
  .recap {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-32);
  }
  .title {
    font-family: var(--display);
    font-size: var(--fs-34);
    line-height: 40px;
    letter-spacing: -0.025em;
    font-weight: 800;
    margin-top: var(--s-12);
    text-wrap: balance;
  }
  .caption {
    margin-top: var(--s-8);
    font-size: var(--fs-14);
    line-height: 20px;
    color: var(--muted);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 640px) {
    .recap {
      padding-top: var(--s-32);
    }
    .title {
      font-size: var(--fs-27);
      line-height: 32px;
      letter-spacing: -0.02em;
    }
  }
</style>
