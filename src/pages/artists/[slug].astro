---
/**
 * /artists/{slug}/ — artist page (CF-6 · US-9/14): name (display 34), intro
 * (sans body — only when a body exists; an aggregation-only page is a
 * designed state, never an apology, R-4) and "{이름}을 다룬 글" in archive
 * row format (no scores — browsing surface, D2). Multi-artist albums
 * aggregate to every credited artist (SS-12). Intro and aggregation are
 * order-independent by construction — the sections don't know each other.
 */
import { getCollection, render } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import FormatLabel from '../../components/FormatLabel.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/derive/site-data.ts';

export async function getStaticPaths() {
  const artists = await getCollection('artists');
  return artists.map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}

const { artist } = Astro.props;
const { archive, articleByUrl } = getSiteData();

const hasIntro = (artist.body ?? '').trim().length > 0;
const Intro = hasIntro ? (await render(artist)).Content : null;
const items = (archive.by_artist.get(artist.id) ?? []).map((i) => articleByUrl.get(i.url)!).filter(Boolean);
---

<Base
  title={artist.data.name}
  description={`${artist.data.name}을(를) 다룬 글.`}
  path={`/artists/${artist.id}/`}
  current="artists"
>
  <main class="artist">
    <header>
      <FormatLabel text="Artists" />
      <h1 class="name">{artist.data.name}</h1>
    </header>

    {
      Intro && (
        <section class="intro prose">
          <Intro />
        </section>
      )
    }

    {
      items.length > 0 && (
        <section aria-label={`${artist.data.name}을 다룬 글`}>
          <h2 class="agg-title">{artist.data.name}을 다룬 글</h2>
          <ul class="cards">
            {items.map((item) => (
              <ArticleCard item={item} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

<style>
  .artist {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-32);
  }
  .name {
    font-family: var(--display);
    font-size: var(--fs-34);
    line-height: 40px;
    letter-spacing: -0.025em;
    font-weight: 800;
    margin-top: var(--s-12);
    text-wrap: balance;
  }
  .intro {
    max-width: var(--column);
    font-family: var(--sans);
    font-size: var(--fs-17);
    line-height: 1.8;
    letter-spacing: -0.003em;
  }
  .intro :global(p) {
    margin: 0 0 var(--s-24);
  }
  .agg-title {
    font-family: var(--display);
    font-size: var(--fs-21);
    line-height: 26px;
    letter-spacing: -0.01em;
    font-weight: 800;
    margin-bottom: var(--s-8);
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 640px) {
    .artist {
      padding-top: var(--s-32);
    }
    .name {
      font-size: var(--fs-27);
      line-height: 32px;
      letter-spacing: -0.02em;
    }
  }
</style>
