---
/**
 * /artists/ — the artist index (2026-09-07), promoted from an axis on
 * /archive/ to a page with its own nav item.
 *
 * It is a LOOKUP surface: a reader arrives with a name in mind. So it is a
 * list, in name order, at scanning density — the same decision the archive
 * listings make, and deliberately the opposite of the home's cover grids.
 * Album art would not help here anyway: an artist has no single cover, and
 * picking one of their albums to stand for them would be an editorial claim
 * this page does not get to make.
 *
 * Order and counts come from the derive layer (`artistIndex`); the sort key
 * and why it is not "most written about" are argued in
 * lib/derive/archive.ts. This page renders the result (P1).
 *
 * D2: a browsing surface. ArtistIndexEntry has no score field — the figure
 * cannot reach here even by accident, which is the same type-level guard
 * ArticleItem uses.
 *
 * The empty case reuses SectionEmpty. That is NOT an extension of the
 * home-only R-4 release: this page exists unconditionally because it is in
 * the masthead, so nothing is being "shown empty instead of omitted" — the
 * page simply has nothing to list, and it says so the same wordless way the
 * home does. In practice it is unreachable while any article exists (E-113
 * fails the build on an artist nobody references).
 */
import SectionEmpty from '../../components/SectionEmpty.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/derive/site-data.ts';
import { withBase } from '../../lib/paths.ts';

const { artistIndex } = getSiteData();

// "평론 2편 · 이야기 1편" — a format with nothing in it is left out rather
// than printed as a zero (R-4 applies to the parts of a row too).
const countLabel = (e: { reviews: number; stories: number }) =>
  [e.reviews > 0 ? `평론 ${e.reviews}편` : null, e.stories > 0 ? `이야기 ${e.stories}편` : null]
    .filter(Boolean)
    .join(' · ');
---

<Base
  title="Artists"
  description="undernote가 다룬 아티스트 전체."
  path="/artists/"
  current="artists"
>
  <main class="artists">
    {/* No overline: the h1 already IS the section name (title-system rule,
        global.css). This page pairs with /archive/ and the two type presets,
        which are titled the same way. */}
    <h1 class="page-title">Artists</h1>

    {
      artistIndex.length > 0 ? (
        <ul class="rows">
          {artistIndex.map((entry) => (
            <li class="row">
              <a class="row-link" href={withBase(`/artists/${entry.slug}/`)}>
                <span class="name">{entry.name}</span>
                <span class="count tnum">{countLabel(entry)}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <SectionEmpty />
      )
    }
  </main>
</Base>

<style>
  .artists {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
  }
  .rows {
    list-style: none;
    margin: var(--s-24) 0 0;
    padding: 0;
  }
  /* Name left, counts right, on one line — the archive row's grammar minus
     the thumbnail column, because there is no artwork to show. */
  .row-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-16);
    min-height: 44px;
    padding: var(--s-12) var(--s-8);
    border-bottom: 1px solid var(--line);
    transition: background var(--t-micro);
  }
  .row-link:hover {
    background: var(--surface-2);
  }
  .name {
    font-size: var(--fs-16);
    line-height: 22px;
    letter-spacing: -0.01em;
    font-weight: 700;
    color: var(--ink);
    transition: color var(--t-micro);
  }
  .row-link:hover .name {
    color: var(--accent-2-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .count {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.04em;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .artists {
      padding-top: var(--s-32);
    }
  }
</style>
