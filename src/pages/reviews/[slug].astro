---
/**
 * Review page /reviews/{slug}/ (ui-spec §2 · CF-1 · D2-R).
 *
 * The frontmatter here only LOADS data and calls the derive layer — every
 * judgment (labels, cover set, listen links, formatting) lives in
 * src/lib/derive/review-page.ts (P1: templates render, they don't decide).
 *
 * D2-R placement (2026-09-06, editor's call — supersedes D2 "말미 배치"):
 * hero = score dial + 4 fields + nominate badge; the tail keeps only the
 * listen row. Hero artist names link to /artists/{slug}/ (US-9 AC1).
 */
import { getCollection, getEntry, render } from 'astro:content';
import CoverImage from '../../components/CoverImage.astro';
import FormatLabel from '../../components/FormatLabel.astro';
import ScoreMark from '../../components/ScoreMark.astro';
import NominateBadge from '../../components/NominateBadge.astro';
import ListenBlock from '../../components/ListenBlock.astro';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LadderBlock from '../../components/LadderBlock.astro';
import { excerptFrom } from '../../lib/derive/excerpt.ts';
import { deriveBacklinks } from '../../lib/derive/links.ts';
import { buildReviewPageData, otherWorkByArtist } from '../../lib/derive/review-page.ts';
import { getSiteConfig } from '../../lib/site.ts';
import { getSiteData } from '../../lib/derive/site-data.ts';
import { withBase } from '../../lib/paths.ts';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review } }));
}

const { review } = Astro.props;

// Single load path (P2/m-5): genres come from the same getSiteData() call
// every other derivation uses, instead of a second readFileSync+parse of
// config/genres.yaml — one source, not two that could drift.
const siteData = getSiteData();

// Cross-references — existence is guaranteed by the checker gate (E-102/103);
// a miss here would be a build bug, so the non-null assertions are safe.
const album = (await getEntry('albums', review.data.album))!;
const artistEntries = await Promise.all(album.data.artists.map((slug) => getEntry('artists', slug)));
const artists = new Map(artistEntries.filter((e) => e != null).map((e) => [e.id, e.data]));

const page = buildReviewPageData({
  slug: review.id,
  review: review.data,
  album: album.data,
  artists,
  genres: siteData.data.genres!,
  site: getSiteConfig(),
});

const { Content } = await render(review);
const description = excerptFrom(review.body ?? '');

// Nominate badge (SS-4 derive): present only while this album sits on the
// active board — the verdict block hides the row otherwise (R-4).
const badge = siteData.badgeMap.get(review.id) ?? null;
const nominate = badge ? { bucketLabel: badge.bucketLabel, rank: badge.rank, year: badge.year } : null;

// Follow blocks (§2.5 fixed order): ① the ladder ② "{artist}'s other work".
const backlinks = deriveBacklinks(
  { slug: review.id, tags: album.data.tags, bucket: album.data.bucket },
  siteData.ladder.stories,
  siteData.ladder.refIndex,
  siteData.ladder.albumBuckets,
);
const otherByArtist = otherWorkByArtist(
  `/reviews/${review.id}/`,
  album.data.artists,
  siteData.archive.by_artist,
  siteData.articleByUrl,
);
---

<Base
  title={`${page.title} — ${page.artistsLabel}`}
  description={description}
  ogType="article"
  ogImage={`/og/reviews/${page.slug}.png`}
  path={`/reviews/${page.slug}/`}
  current="reviews"
>
  <main>
    <article>
      {/* ── Hero: score dial + 4 fields + badge, cover right (D2-R) ──
          DOM order keeps the overline and h1 first (FormatLabel is read
          first on purpose); the dial is placed left by grid, not by DOM. */}
      <header class="hero">
        <div class="hero-text">
          <FormatLabel text="Reviews" />
          <h1 class="hero-title">{page.title}</h1>
          <p class="hero-sub">
            {page.artistLinks.map((artist, i) => (
              <>
                {i > 0 && ', '}
                <a class="artist-link" href={withBase(`/artists/${artist.slug}/`)}>{artist.name}</a>
              </>
            ))} · {page.bucketLabel} · {page.releaseDateText}
          </p>
          {nominate && <NominateBadge bucketLabel={nominate.bucketLabel} rank={nominate.rank} year={nominate.year} />}
        </div>
        <div class="hero-score">
          <ScoreMark score={page.score} />
        </div>
        <div class="hero-cover">
          <CoverImage cover={page.cover} size={320} albumTitle={page.title} loading="eager" />
        </div>
      </header>

      {/* ── Body: serif 17/1.8, 660px column — the product itself ── */}
      <div class="prose review-body">
        <Content />
      </div>

      {/* ── Tail: listen row only — score and badge now live in the hero (D2-R) ── */}
      <div class="column">
        <ListenBlock listenLinks={page.listenLinks} />
      </div>

      {/* ── Follow blocks — fixed order (§2.5); each renders only with data (R-4) ── */}
      {
        backlinks.mode !== 'none' && (
          <div class="column">
            <LadderBlock mode={backlinks.mode} bucketLabel={page.bucketLabel} stories={backlinks.stories} />
          </div>
        )
      }
      {
        otherByArtist.length > 0 && (
          <section class="column other-articles" aria-label={`${page.artistsLabel}의 다른 글`}>
            <h2 class="other-title">{page.artistsLabel}의 다른 글</h2>
            <ul class="other-cards">
              {otherByArtist.map((item) => (
                <ArticleCard item={item} />
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>
</Base>

<style>
  .hero {
    max-width: var(--shell);
    margin: 0 auto;
    padding: var(--s-48) 20px 0;
    display: grid;
    /* dial · text · cover — explicit placement so the DOM can keep h1 first */
    grid-template-columns: auto 1fr auto;
    gap: var(--s-32);
    align-items: end;
  }
  .hero-score {
    grid-column: 1;
    grid-row: 1;
  }
  .hero-text {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-12);
  }
  .hero-cover {
    grid-column: 3;
    grid-row: 1;
  }
  .hero-title {
    font-family: var(--serif);
    font-size: var(--fs-34);
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
  }
  .hero-sub {
    font-size: var(--fs-17);
    color: var(--muted);
  }
  /* Underline keeps the link visible without color alone (WCAG 1.4.1). */
  .artist-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--t-micro);
  }
  .artist-link:hover {
    color: var(--seal);
  }
  .column,
  .review-body {
    max-width: var(--column);
    margin: 0 auto;
    padding: 0 20px;
  }
  .review-body {
    margin-top: var(--s-48);
    font-family: var(--serif);
    font-size: var(--fs-17);
    line-height: 1.8;
  }
  .review-body :global(p) {
    margin: 0 0 var(--s-24);
  }
  .review-body :global(h2) {
    font-family: var(--serif);
    font-size: var(--fs-21);
    font-weight: 700;
    margin: var(--s-32) 0 var(--s-16);
  }
  .review-body :global(blockquote) {
    margin: 0 0 var(--s-24);
    padding-left: var(--s-16);
    border-left: 2px solid var(--line);
    color: var(--muted);
  }
  .other-articles {
    margin-top: var(--s-48);
  }
  .other-title {
    font-size: var(--fs-17);
    font-weight: 700;
    margin-bottom: var(--s-8);
  }
  .other-cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
    }
    /* cover on top, then the dial, then the text (ui-spec §2.1 — the score
       stays above the fold, which is the whole point of D2-R) */
    .hero-cover {
      grid-column: 1;
      grid-row: 1;
    }
    .hero-score {
      grid-column: 1;
      grid-row: 2;
    }
    .hero-text {
      grid-column: 1;
      grid-row: 3;
    }
  }
</style>
