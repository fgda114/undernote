---
/**
 * Review page /reviews/{slug}/ (ui-spec §2 · CF-1 · D2-R · layouts.md §3).
 *
 * The frontmatter here only LOADS data and calls the derive layer — every
 * judgment (labels, cover set, listen links, formatting) lives in
 * src/lib/derive/review-page.ts (P1: templates render, they don't decide).
 *
 * Layout (2026-09 reskin, rail revised 2026-09-07): a full-width title
 * block, then two columns — a 320px rail (cover · score plate · spec block ·
 * nominate badge) and the criticism itself. The score sits directly beneath
 * the cover with no gap so the pair reads as one object, and at THIS size it
 * is still never laid over the artwork (ADR-0008); the one place the site
 * now overlays a cover is the 64px list thumbnail, and the amended rule is
 * written out in ArticleCard.
 *
 * The rail lost its cover-credit line and gained the nominate badge in the
 * same edit — both editorial decisions, both recorded in
 * 08-impl-notes/frontend.md with what they remove and how to undo them.
 *
 * DOM order is load-bearing. The dist matrix test slices the page at the
 * first `class="hero` and again at `review-body`, then asserts the score
 * appears exactly once in between and never after — that is the machine
 * version of "the verdict is the entry point, not a spoiler at the end".
 */
import { getCollection, getEntry, render } from 'astro:content';
import CoverImage from '../../components/CoverImage.astro';
import FormatLabel from '../../components/FormatLabel.astro';
import ScoreMark from '../../components/ScoreMark.astro';
import SpecMeta from '../../components/SpecMeta.astro';
import NominateBadge from '../../components/NominateBadge.astro';
import ListenBlock from '../../components/ListenBlock.astro';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdjacentNav from '../../components/AdjacentNav.astro';
import LadderBlock from '../../components/LadderBlock.astro';
import { excerptFrom } from '../../lib/derive/excerpt.ts';
import { deriveBacklinks } from '../../lib/derive/links.ts';
import { buildReviewPageData, otherWorkByArtist } from '../../lib/derive/review-page.ts';
import { getSiteConfig } from '../../lib/site.ts';
import { getSiteData } from '../../lib/derive/site-data.ts';
import { withBase } from '../../lib/paths.ts';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review } }));
}

const { review } = Astro.props;

// Single load path (P2/m-5): genres come from the same getSiteData() call
// every other derivation uses, instead of a second readFileSync+parse of
// config/genres.yaml — one source, not two that could drift.
const siteData = getSiteData();

// Cross-references — existence is guaranteed by the checker gate (E-102/103);
// a miss here would be a build bug, so the non-null assertions are safe.
const album = (await getEntry('albums', review.data.album))!;
const artistEntries = await Promise.all(album.data.artists.map((slug) => getEntry('artists', slug)));
const artists = new Map(artistEntries.filter((e) => e != null).map((e) => [e.id, e.data]));

const page = buildReviewPageData({
  slug: review.id,
  review: review.data,
  album: album.data,
  artists,
  genres: siteData.data.genres!,
  site: getSiteConfig(),
  tagLabels: new Map((siteData.data.tags?.tags ?? []).map((t) => [t.slug, t.label])),
});

const { Content } = await render(review);
const description = excerptFrom(review.body ?? '');

// Nominate badge (SS-4 derive): present only while this album sits on the
// active board — the hero hides the row otherwise (R-4). Only rank/year make
// it into the prop object below — `badge.bucketLabel` (BadgeInfo,
// lib/derive/lists.ts) is still computed by deriveBadgeMap but has no
// consumer left on this page since the badge's copy stopped naming a genre
// (NominateBadge.astro's own intro, 2026-09-09); that field is now dead from
// this call site's point of view, reported rather than removed at its
// source (lists.ts is outside this package's owned paths).
const badge = siteData.badgeMap.get(review.id) ?? null;
const nominate = badge ? { rank: badge.rank, year: badge.year } : null;

// Follow blocks (§2.5 fixed order): ① the ladder ② "{artist}'s other work".
const backlinks = deriveBacklinks(
  { slug: review.id, tags: album.data.tags, buckets: album.data.buckets },
  siteData.ladder.stories,
  siteData.ladder.refIndex,
  siteData.ladder.albumBuckets,
);
const otherByArtist = otherWorkByArtist(
  `/reviews/${review.id}/`,
  album.data.artists,
  siteData.archive.by_artist,
  siteData.articleByUrl,
);

// Prev/Next (§2.5 ③, 2026-09-09) — within reviews only, publication-date
// order (lib/derive/lists.ts#deriveAdjacentMap). This review's own URL is
// normally guaranteed a key here (the map is built from allArticles, which
// every published review is part of by construction) — the `?? {…}` fallback
// exists only for astro:content's `getStaticPaths()` and this module's own
// direct `loadRepo()` read disagreeing about which pages currently exist
// (observed once, from a stale content-layer cache in a sandbox that had
// just deleted the file this page renders for — see build.ladder.spec.ts's
// "④ none" case). R-4's own rule applies the same way here as everywhere
// else: nothing to show is nothing rendered, not a crash.
const { prev, next } = siteData.adjacent.get(`/reviews/${review.id}/`) ?? { prev: null, next: null };
---

<Base
  title={`${page.title} — ${page.artistsLabel}`}
  description={description}
  ogType="article"
  ogImage={`/og/reviews/${page.slug}.png`}
  path={`/reviews/${page.slug}/`}
  current="reviews"
  preloadSerif
>
  <main>
    <article>
      {/* ── Title block: above both columns, on the reading measure ── */}
      <div class="review-head">
      <header class="hero">
        <FormatLabel text="Reviews" variant="chip" />
        <h1 class="hero-title">{page.title}</h1>
        {/* Third segment is the release YEAR only, not the full date
            (2026-09-09, decision-maker request) — this line is the
            at-a-glance byline, and the exact day already lives one column
            over in the spec block's own Release row (SpecMeta), directly
            above Reviewed so the two dates can be compared. Repeating the
            full date here duplicated that row for free; the year alone still
            places the record in time without pre-empting it. `releaseYear`
            (ReviewPageData) is the same already-parsed 4-digit string
            SpecMeta's Release row links from — not a re-slice of
            `releaseDateText` here, which would silently drift the day that
            field's own format changes (see releaseYear's own doc). First
            bucket only (`page.bucketLabel`) — unchanged, see that field's doc. */}
        <p class="hero-sub">
          {page.artistLinks.map((artist, i) => (
            <>
              {i > 0 && ', '}
              <a class="artist-link" href={withBase(`/artists/${artist.slug}/`)}>{artist.name}</a>
            </>
          ))} · {page.bucketLabel} · {page.releaseYear}
        </p>
      </header>
      </div>

      <div class="review-layout">
        {/* ── Rail: cover → score → credit → spec. Not sticky: the spec block
            is something you check before reading, not a running reference,
            and a 700px rail gets clipped in a short window. ── */}
        <aside class="hero-rail">
          <div class="rail-cover">
            <CoverImage cover={page.cover} size={320} albumTitle={page.title} loading="eager" />
          </div>
          <ScoreMark score={page.score} />
          {/* THE COVER CREDIT LINE IS GONE from the page (2026-09-07). The
              DATA is untouched — content/albums/*.yaml still carries
              cover_source and buildReviewPageData still derives it — only
              the rendering was removed, by editorial decision. What that
              costs is recorded with the rights-contact removal in
              08-impl-notes/frontend.md, including the one line that puts it
              back. */}
          <SpecMeta
            title={page.title}
            subtitle={page.subtitle}
            artistLinks={page.artistLinks}
            releaseDateText={page.releaseDateText}
            releaseYear={page.releaseYear}
            bucketLabels={page.bucketLabels}
            reviewDate={page.reviewDate}
            label={page.label}
            duration={page.duration}
            tags={page.tags}
          />
          {/* THE BADGE MOVED HERE from the hero (2026-09-07), below the spec
              block, at the foot of the rail. It belongs with the rail's other
              derived facts (genre, release, review date) rather than with the
              headline: it is a consequence of the score, not part of naming
              the record. The move also fixes the stacked order on narrow
              screens, where the single column used to hand the reader the
              badge BEFORE the score it is derived from. Still inside the
              hero→review-body slice the dist matrix measures, so the
              "one score in the hero, none after the body" contract is
              unaffected. */}
          {nominate && (
            <div class="rail-badge">
              <NominateBadge rank={nominate.rank} year={nominate.year} />
            </div>
          )}
        </aside>

        <div class="review-main">
          {/* ── Body: serif 17/1.85, 660px column — the product itself ── */}
          <div class="prose review-body">
            <Content />
          </div>

          {/* ── Tail: listen row only — score and badge live in the hero (D2-R) ── */}
          <div class="column">
            <ListenBlock listenLinks={page.listenLinks} />
          </div>

          {/* ── Follow blocks — fixed order (§2.5); each renders only with data (R-4) ── */}
          {
            backlinks.mode !== 'none' && (
              <div class="column">
                <LadderBlock mode={backlinks.mode} bucketLabel={page.bucketLabel} stories={backlinks.stories} />
              </div>
            )
          }
          {
            otherByArtist.length > 0 && (
              <section class="column other-articles" aria-label={`${page.artistsLabel}의 다른 글`}>
                <h2 class="other-title">{page.artistsLabel}의 다른 글</h2>
                <ul class="other-cards">
                  {otherByArtist.map((item) => (
                    <ArticleCard item={item} />
                  ))}
                </ul>
              </section>
            )
          }
          <div class="column">
            <AdjacentNav prev={prev} next={next} />
          </div>
        </div>
      </div>
    </article>
  </main>
</Base>

<style>
  /* --reading-shell, not --shell: see tokens.css. The title block and the
     two columns below it take the SAME bound so their left edges line up;
     capping only the columns would have left the headline hanging 190px
     further out than the prose it introduces. */
  .hero {
    width: min(var(--reading-shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 var(--s-32);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-12);
  }
  /* The dividing rule stays FULL FRAME while the text above it is capped:
     it separates two parts of the page, so it belongs to the page, not to
     the column. Drawn on the wrapper rather than the hero for that reason. */
  .review-head {
    border-bottom: 1px solid var(--line);
  }
  .hero-title {
    font-family: var(--display);
    font-size: var(--fs-44);
    line-height: 48px;
    letter-spacing: -0.03em;
    font-weight: 800;
    text-wrap: balance;
  }
  .hero-sub {
    font-size: var(--fs-17);
    line-height: 24px;
    color: var(--muted);
  }
  /* Underline keeps the link visible without color alone (WCAG 1.4.1). */
  .artist-link {
    color: var(--accent-2-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: text-decoration-thickness var(--t-micro);
  }
  .artist-link:hover {
    text-decoration-thickness: 2px;
  }

  .review-layout {
    width: min(var(--reading-shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-32) 0 0;
    display: grid;
    /* The rail is a fixed 320 (= the cover's edge) and the body takes the
       rest. Bounded by --reading-shell the rest is exactly --column, so the
       prose fills its track instead of sitting in the left of a 1032px one
       with dead space to its right — which is what widening --shell to 1440
       would otherwise have produced. */
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: var(--s-48);
    align-items: start;
  }
  /* No gap between the cover and the plate directly under it — the two
     read as a single stamped object. Everything below sets its own margin. */
  .hero-rail {
    display: flex;
    flex-direction: column;
  }
  /* The spec block used to be spaced from the cover credit above it; with
     the credit gone it is spaced from the score plate instead — same gap,
     one fewer thing in the rail. */
  .hero-rail :global(.spec) {
    margin-top: var(--s-16);
  }
  .rail-badge {
    margin-top: var(--s-16);
  }

  .review-main {
    min-width: 0;
  }
  .column,
  .review-body {
    max-width: var(--column);
  }
  .review-body {
    font-family: var(--serif);
    font-size: var(--fs-17);
    line-height: 1.85;
  }
  .review-body :global(p) {
    margin: 0 0 var(--s-24);
  }
  .review-body :global(h2) {
    font-size: var(--fs-21);
    line-height: 30px;
    letter-spacing: -0.005em;
    font-weight: 700;
    color: var(--ink);
    margin: var(--s-32) 0 var(--s-16);
  }
  .review-body :global(blockquote) {
    margin: 0 0 var(--s-24);
    padding-left: var(--s-16);
    border-left: 2px solid var(--line-strong);
    color: var(--muted);
  }
  .other-articles {
    margin-top: var(--s-48);
  }
  .other-title {
    font-family: var(--display);
    font-size: var(--fs-21);
    line-height: 26px;
    letter-spacing: -0.01em;
    font-weight: 800;
    margin-bottom: var(--s-8);
  }
  .other-cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 959px) {
    .review-layout {
      grid-template-columns: 1fr;
      gap: var(--s-24);
    }
    /* THE RAIL KEEPS ITS OWN WIDTH WHEN THE GRID COLLAPSES (2026-09-10,
       decision-maker: "리뷰 상세 글에서 점수가 앨범커버 사진 폭이랑 동일하고
       바로 밑에 딱 붙어있게").

       `.score-mark` is `width: 100%` (ScoreMark.astro). On the desktop that
       100% is the 320px grid column, so the plate came out exactly the
       cover's width, flush under it — the "single stamped object" the
       desktop rule above describes. Below 960px the two-column grid becomes
       `1fr`, so the rail became the WHOLE FRAME and the plate stretched with
       it while the cover stayed at its own edge length. Measured before this
       fix: 390px → cover 320 / plate 350; 640px → 320 / 600; 959px → 320 /
       856, an 88px-tall bar nearly three times the width of the artwork it
       belongs to.

       Giving the rail `--rail` here restores the desktop relationship
       instead of restating it: the plate's own `width: 100%` resolves
       against the same box the cover does, so the two cannot drift apart
       again — there is no second copy of the cover's width to keep in sync.
       `max-width: 100%` is what keeps 360px and 320px viewports (where the
       frame is narrower than `--rail`) from overflowing.

       `gap: var(--s-12)` USED TO BE HERE and is deleted with the same edit:
       it put 12px between the cover and the plate, which is precisely the
       "flush" the desktop rule spends a comment on. Spacing below the plate
       comes back from the base rules' own margins (`.spec` and
       `.rail-badge`, both `margin-top: var(--s-16)`), which is how the
       desktop rail has always done it. */
    .hero-rail {
      width: var(--rail);
      max-width: 100%;
    }
    /* REVERSED 2026-09-10, decision-maker direction: "모바일 리뷰 점수는
       앨범사진 아래에 있어야지...데스크탑처럼" (the mobile score belongs
       BELOW the album cover, like on desktop). `order: -1` used to sit here,
       moving the plate ABOVE the cover on narrow screens — the original
       reasoning is kept rather than deleted, because the shape of that
       argument will come up again:

         "The plate moves above the cover on narrow screens: a full-width
         score right under the title keeps 'this album = this score' in one
         glance, instead of pushing it below a 360px square (D2-R's entry
         point)."

       That trade — score-before-cover for a faster glance — was overruled by
       the decision-maker in favour of matching the desktop rail's own order
       (cover, then score, flush under it). Removing `order: -1` returns the
       plate to source order, which IS the desktop order already — no grid-
       row/column reassignment needed here, only the property that fought it.
       `.rail-cover`'s mobile cap below is unrelated to either order and is
       unaffected. See 08-impl-notes/frontend.md for the post-reversal width
       measurement (the original comment's "full-width score" claim, checked
       against what the plate now renders at under the 360px cover). */
    /* `.rail-cover { max-width: 360px }` and `.hero-rail :global(.spec)
       { margin-top: 0 }` both lived here and are DELETED (2026-09-10).
       The 360px cap never bound once the rail is `--rail` (320px) wide, and
       the `margin-top: 0` existed only to avoid double-spacing against the
       `gap` above — with the gap gone it would have left the spec block
       touching the plate. Both were props for a layout that no longer
       exists; removing them is what makes the mobile rail the same object
       the desktop rail is, rather than a second one that happens to look
       similar. */
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: var(--s-32);
    }
    .hero-title {
      font-size: var(--fs-34);
      line-height: 36px;
      letter-spacing: -0.02em;
    }
    .hero-sub {
      font-size: var(--fs-15);
      line-height: 22px;
    }
    .review-body {
      line-height: 1.8;
    }
  }
</style>
