---
/**
 * Home — W5.1 keeps this as the pre-launch empty state (ui-spec §1.5 last
 * variant: no reviews published yet → about-gist + one honest line). The full
 * nominate board (일반/극초기/확정 variants) is W5.2's story.
 * No Date(), no client JS — deterministic output is a product promise.
 */
import Base from '../layouts/Base.astro';
import { getSiteConfig } from '../lib/site.ts';

const site = getSiteConfig();
---

<Base title={site.site_name} description="이 리스트의 모든 앨범에는 이미 평론이 씌어 있다." path="/">
  <main class="home">
    <p class="lede">여기 실린 앨범은 전부 “안 들으면 손해” 문턱을 통과한 것입니다.</p>
    <p class="status">첫 평론을 준비하고 있습니다.</p>
  </main>
</Base>

<style>
  .home {
    max-width: var(--column);
    margin: 0 auto;
    padding: var(--s-96) 20px 0;
  }
  .lede {
    font-family: var(--serif);
    font-size: var(--fs-21);
    font-weight: 700;
    line-height: 1.5;
    text-wrap: balance;
  }
  .status {
    margin-top: var(--s-16);
    color: var(--muted);
    font-size: var(--fs-15);
  }
</style>
