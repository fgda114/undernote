---
/**
 * /archive/ — the 4-axis browse hub (ui-spec §6), replacing the W5.2 shell.
 * Axes: Year(발행 기준) / Genre(버킷 — bold labels) / Tags(muted chips — the
 * tab itself disappears while the registry is empty) / Artists. Axis titles
 * are set as structural LABELS, not headings: an axis name is scaffolding,
 * the values are the content. Type presets
 * (평론·이야기) sit on top — the global nav lands there. Empty axis values
 * simply don't exist (R-4). No scores anywhere on browsing surfaces (D2).
 */
import Base from '../../layouts/Base.astro';
import { ETC_BUCKET_LABEL } from '../../lib/derive/archive.ts';
import { getSiteData } from '../../lib/derive/site-data.ts';
import { withBase } from '../../lib/paths.ts';

const { archive, data } = getSiteData();

const years = [...archive.by_year.keys()].sort().reverse();

const bucketLabels = new Map<string, string>();
for (const block of data.genres?.years ?? []) {
  for (const bucket of block.buckets) if (!bucketLabels.has(bucket.id)) bucketLabels.set(bucket.id, bucket.label);
}
const buckets = [...archive.by_bucket.keys()]
  .sort()
  .map((id) => ({ id, label: id === 'etc' ? ETC_BUCKET_LABEL : (bucketLabels.get(id) ?? id) }));

const tagLabels = new Map((data.tags?.tags ?? []).map((t) => [t.slug, t.label]));
const tags = [...archive.by_tag.keys()].sort().map((slug) => ({ slug, label: tagLabels.get(slug) ?? slug }));

const artistNames = new Map(data.artists.map((a) => [a.slug, a.data.name]));
const artists = [...archive.by_artist.keys()].sort().map((slug) => ({ slug, name: artistNames.get(slug) ?? slug }));
---

<Base title="Archive" description="연도·장르·태그·아티스트로 찾아보는 전체 글." path="/archive/" current="archive">
  <main class="archive">
    <h1 class="page-title">Archive</h1>

    <ul class="presets">
      <li><a href={withBase('/archive/reviews/')}>Reviews</a></li>
      <li><a href={withBase('/archive/stories/')}>Notes</a></li>
    </ul>

    {
      years.length > 0 && (
        <section class="axis">
          <h2 class="axis-title">Year</h2>
          <ul class="values">
            {years.map((year) => (
              <li>
                <a class="value-strong tnum" href={withBase(`/archive/${year}/`)}>{year}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      buckets.length > 0 && (
        <section class="axis">
          <h2 class="axis-title">Genre</h2>
          <ul class="values">
            {buckets.map((bucket) => (
              <li>
                <a class="value-strong" href={withBase(`/archive/genre/${bucket.id}/`)}>{bucket.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      /* Tag tab hidden entirely while no tags exist (ui-spec §6). */
      tags.length > 0 && (
        <section class="axis">
          <h2 class="axis-title">Tags</h2>
          <ul class="values">
            {tags.map((tag) => (
              <li>
                <a class="chip" href={withBase(`/archive/tag/${tag.slug}/`)}>{tag.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      artists.length > 0 && (
        <section class="axis">
          <h2 class="axis-title">Artists</h2>
          <ul class="values">
            {artists.map((artist) => (
              <li>
                <a class="value-strong" href={withBase(`/artists/${artist.slug}/`)}>{artist.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

<style>
  .archive {
    max-width: var(--shell);
    margin: 0 auto;
    padding: var(--s-48) 20px 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-32);
  }
  .page-title {
    font-family: var(--display);
    font-size: var(--fs-27);
    line-height: 32px;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .presets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-16);
    flex-wrap: wrap;
  }
  /* Filled chips: the preset is a destination, the axis values below are a
     vocabulary — the fill separates the two without adding a colour. */
  .presets a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-12);
    background: var(--surface-2);
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--fs-13);
    line-height: 16px;
    letter-spacing: 0.08em;
    font-weight: 700;
    text-transform: uppercase;
    transition: color var(--t-micro);
  }
  .presets a:hover {
    color: var(--accent-2-ink);
  }
  .axis-title {
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: var(--label-ls);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--muted);
  }
  .values {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8) var(--s-16);
  }
  /* Buckets/years/artists: bold ink labels — tags: quiet chips.
     The visual split IS the two-tier genre statement (ADR-0007). */
  .value-strong {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-16);
    line-height: 22px;
    font-weight: 700;
    color: var(--ink);
  }
  .value-strong:hover {
    color: var(--accent-2-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-12);
    font-family: var(--mono);
    font-size: var(--fs-12);
    line-height: 16px;
    letter-spacing: 0.04em;
    font-weight: 500;
    color: var(--muted);
    background: var(--surface-3);
    border-radius: var(--r-0);
    transition: color var(--t-micro), background var(--t-micro);
  }
  .chip:hover {
    color: var(--accent-2-ink);
    background: var(--surface-2);
  }
  @media (max-width: 640px) {
    .archive {
      padding-top: var(--s-32);
    }
  }
</style>
