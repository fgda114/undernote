---
/**
 * /archive/tag/{tag}/ — detail-tag axis (canonical slugs). Pages exist only
 * for tags that actually appear on content (empty values never render, R-4).
 */
import FormatLabel from '../../../components/FormatLabel.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Base from '../../../layouts/Base.astro';
import { getSiteData } from '../../../lib/derive/site-data.ts';

export async function getStaticPaths() {
  const { archive } = getSiteData();
  return [...archive.by_tag.keys()].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const { archive, articleByUrl, data } = getSiteData();
const items = (archive.by_tag.get(tag!) ?? []).map((i) => articleByUrl.get(i.url)!).filter(Boolean);
const label = (data.tags?.tags ?? []).find((t) => t.slug === tag)?.label ?? tag!;
---

<Base title={`${label} — Archive`} description={`태그 ${label}의 전체 글.`} path={`/archive/tag/${tag}/`} current="archive">
  <main class="listing">
    {/* The h1 is a VALUE on an axis, not the axis name, so it takes the
        overline (title-system rule, global.css). */}
    <FormatLabel text="Archive" />
    <h1 class="page-title">{label}</h1>
    <ul class="cards">
      {items.map((item) => <ArticleCard item={item} />)}
    </ul>
  </main>
</Base>

<style>
  .listing {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
  }
  .cards {
    list-style: none;
    margin: var(--s-24) 0 0;
    padding: 0;
  }
  /* MISSING ON THIS PAGE UNTIL NOW (2026-09-08) — see the identical note in
     archive/[year].astro, this page's axis-value sibling. */
  @media (max-width: 640px) {
    .listing {
      padding-top: var(--s-32);
    }
  }
</style>
