---
/**
 * /archive/stories/ — type preset — the global nav's Notes target (full listing).
 * Lists stories as ArticleCards (no scores — browsing surface, D2).
 */
import ArticleCard from '../../components/ArticleCard.astro';
import SectionEmpty from '../../components/SectionEmpty.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/derive/site-data.ts';

const { allArticles } = getSiteData();
const stories = allArticles.filter((item) => item.type === 'story');
---

<Base title="Notes" description="발행된 음악 이야기 전체." path="/archive/stories/" current="stories">
  <main class="listing">
    <h1 class="page-title">Notes</h1>
    {
      stories.length > 0 ? (
        <ul class="cards">
          {stories.map((item) => (
            /* showFormat={false} — same reason as /archive/reviews/: the
               h1 is "Notes" and nothing but a note can appear under it. */
            <ArticleCard item={item} showFormat={false} />
          ))}
        </ul>
      ) : (
        /* Was "아직 발행된 이야기가 없습니다." (removed 2026-09-07). "아직" is
           the publication apologising for its own age, which the same round
           of edits stripped from the home strip, the Charts caption and
           /list/{year}/. An empty listing needs no sentence: the heading
           already named what would be here. */
        <SectionEmpty />
      )
    }
  </main>
</Base>

<style>
  .listing {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
  }
  .cards {
    list-style: none;
    margin: var(--s-24) 0 0;
    padding: 0;
  }
  /* MISSING ON THIS PAGE UNTIL NOW (2026-09-08) — see the identical note in
     archive/reviews.astro, this page's mirror preset. */
  @media (max-width: 640px) {
    .listing {
      padding-top: var(--s-32);
    }
  }
</style>
