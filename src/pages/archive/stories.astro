---
/**
 * /archive/stories/ — preset shell (W5.3 replaces with the filtered archive).
 * Lists stories as ArticleCards (no scores — browsing surface, D2).
 */
import ArticleCard from '../../components/ArticleCard.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/derive/site-data.ts';

const { latestArticles } = getSiteData();
const stories = latestArticles.filter((item) => item.type === 'story');
---

<Base title="이야기" description="발행된 음악 이야기 전체." path="/archive/stories/" current="stories">
  <main class="listing">
    <h1 class="page-title">음악 이야기</h1>
    {
      stories.length > 0 ? (
        <ul class="cards">
          {stories.map((item) => (
            <ArticleCard item={item} />
          ))}
        </ul>
      ) : (
        <p class="empty">아직 발행된 이야기가 없습니다.</p>
      )
    }
  </main>
</Base>

<style>
  .listing {
    max-width: var(--column);
    margin: 0 auto;
    padding: var(--s-48) 20px 0;
  }
  .page-title {
    font-family: var(--sans);
    font-size: var(--fs-27);
    font-weight: 800;
  }
  .cards {
    list-style: none;
    margin: var(--s-24) 0 0;
    padding: 0;
  }
  .empty {
    margin-top: var(--s-24);
    color: var(--muted);
    font-size: var(--fs-15);
  }
</style>
