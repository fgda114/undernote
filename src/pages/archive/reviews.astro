---
/**
 * /archive/reviews/ — type preset — the global nav's Reviews target (full listing).
 * Lists all reviews as ArticleCards WITH scores — one of the two surfaces
 * D2-R2 reversed D2 for (2026-09-07). The other is the home's 최신 리뷰.
 */
import ArticleCard from '../../components/ArticleCard.astro';
import SectionEmpty from '../../components/SectionEmpty.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/derive/site-data.ts';

const { allArticles } = getSiteData();
const reviews = allArticles.filter((item) => item.type === 'review');
---

<Base title="Reviews" description="발행된 평론 전체." path="/archive/reviews/" current="reviews">
  <main class="listing">
    <h1 class="page-title">Reviews</h1>
    {
      reviews.length > 0 ? (
        <ul class="cards">
          {reviews.map((item) => (
            /* showFormat={false} — the h1 above is "Reviews" and this
               listing holds nothing else, so the per-row REVIEWS overline was
               the page's own title repeated once per entry. The mixed
               listings (/archive/{year}/, /archive/tag/{tag}/) and the
               artist pages keep theirs, where the label is what tells the two
               formats apart. */
            <ArticleCard item={item} showScore showFormat={false} />
          ))}
        </ul>
      ) : (
        /* Was "아직 발행된 …이 없습니다." (removed 2026-09-07). "아직" is the
           publication apologising for its own age, which the same round of
           edits stripped from the home strip, the Charts caption and
           /list/{year}/. An empty listing needs no sentence: the heading
           already named what would be here. */
        <SectionEmpty />
      )
    }
  </main>
</Base>

<style>
  .listing {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
  }
  .cards {
    list-style: none;
    margin: var(--s-24) 0 0;
    padding: 0;
  }
</style>
