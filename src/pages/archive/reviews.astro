---
/**
 * /archive/reviews/ — type preset — the global nav's Reviews target (full listing).
 * Lists all reviews as ArticleCards WITH scores — one of the two surfaces
 * D2-R2 reversed D2 for (2026-09-07). The other is the home's 최신 리뷰.
 */
import ArticleCard from '../../components/ArticleCard.astro';
import SectionEmpty from '../../components/SectionEmpty.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/derive/site-data.ts';

const { allArticles } = getSiteData();
const reviews = allArticles.filter((item) => item.type === 'review');
---

<Base title="Reviews" description="발행된 평론 전체." path="/archive/reviews/" current="reviews">
  <main class="listing">
    <h1 class="page-title">Reviews</h1>
    {
      reviews.length > 0 ? (
        <ul class="cards">
          {reviews.map((item) => (
            /* showFormat={false} — the h1 above is "Reviews" and this
               listing holds nothing else, so the per-row REVIEWS overline was
               the page's own title repeated once per entry. The archive hub
               (mixed types, any axis) and artist pages keep theirs, where the
               label is what tells the two formats apart. */
            <ArticleCard item={item} showScore showFormat={false} />
          ))}
        </ul>
      ) : (
        /* Was "아직 발행된 …이 없습니다." (removed 2026-09-07). "아직" is the
           publication apologising for its own age, which the same round of
           edits stripped from the home strip, the Charts caption and
           /list/{year}/. An empty listing needs no sentence: the heading
           already named what would be here. */
        <SectionEmpty />
      )
    }
  </main>
</Base>

<style>
  .listing {
    width: min(var(--shell), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--s-48) 0 0;
  }
  .cards {
    list-style: none;
    margin: var(--s-24) 0 0;
    padding: 0;
  }
  /* MISSING ON THIS PAGE UNTIL NOW (2026-09-08) — every other .page-title
     page (about, /archive/, /artists/, list/{year}/, the review and story
     heroes) drops its top padding from --s-48 to --s-32 below 640px; this
     page and its four .listing siblings (stories/[year]/genre/tag) did not,
     so the title sat 16px lower here than on the pages a reader compares it
     against directly from the masthead. Same token, same breakpoint as the
     rest of the title system — see global.css's .page-title rules for the
     size half of that system, which this page already inherited correctly. */
  @media (max-width: 640px) {
    .listing {
      padding-top: var(--s-32);
    }
  }
</style>
