---
/**
 * /archive/reviews/ — type preset — the global nav's Reviews target (full listing).
 * Lists all reviews as ArticleCards (no scores — browsing surface, D2).
 */
import ArticleCard from '../../components/ArticleCard.astro';
import Base from '../../layouts/Base.astro';
import { getSiteData } from '../../lib/derive/site-data.ts';

const { allArticles } = getSiteData();
const reviews = allArticles.filter((item) => item.type === 'review');
---

<Base title="Reviews" description="발행된 평론 전체." path="/archive/reviews/" current="reviews">
  <main class="listing">
    <h1 class="page-title">Reviews</h1>
    {
      reviews.length > 0 ? (
        <ul class="cards">
          {reviews.map((item) => (
            <ArticleCard item={item} />
          ))}
        </ul>
      ) : (
        <p class="empty">아직 발행된 평론이 없습니다.</p>
      )
    }
  </main>
</Base>

<style>
  .listing {
    max-width: var(--shell);
    margin: 0 auto;
    padding: var(--s-48) 20px 0;
  }
  .page-title {
    font-family: var(--serif);
    font-size: var(--fs-27);
    font-weight: 700;
  }
  .cards {
    list-style: none;
    margin: var(--s-24) 0 0;
    padding: 0;
  }
  .empty {
    margin-top: var(--s-24);
    color: var(--muted);
    font-size: var(--fs-15);
  }
</style>
